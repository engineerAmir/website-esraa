{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}

  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  {% capture empty_cart_drawer_content %}
    <div
      class="cart-drawer__content"
      aria-label="{{ 'accessibility.cart' | t }}"
    >
      <h2
        class="theme-drawer__title h4"
        id="cart-drawer-heading"
      >
        {{ 'content.your_cart_is_empty' | t }}
      </h2>

      <div class="cart-drawer__items">
        {% render 'cart-products',
          force_empty: true,
          context: 'drawer'
        %}
      </div>
    </div>
  {% endcapture %}

  <theme-drawer
    id="cart-drawer"
    data-skip-node-update
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
    >

      <cart-drawer-component
        {% if settings.auto_open_cart_drawer and template.name != 'cart' %}
          auto-open
        {% endif %}
      >

        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>

        <div
          class="cart-drawer__inner{% if cart.empty? %} cart-drawer--empty{% endif %}"
          data-hydration-key="cart-drawer-inner"
        >

          {%- if cart.empty? -%}

            <div class="theme-drawer__header">

              <button
                on:click="#cart-drawer/close"
                class="theme-drawer__close-button cart-drawer__close-button--empty"
                type="button"
                aria-label="{{ 'actions.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>

            </div>

          {%- else -%}

            {% capture cart_badge_html %}

              <span
                class="theme-drawer__badge{% if cart.item_count == 0 %} visually-hidden{% endif %}"
                aria-hidden="true"
                {% if cart.item_count <= 99 %}
                  data-maintain-ratio
                {% endif %}
              >
                {{- cart.item_count -}}
              </span>

              {% if cart.item_count > 0 %}
                <span class="visually-hidden">
                  {{ 'accessibility.cart_count' | t }}:
                  {{ cart.item_count }}
                </span>
              {% endif %}

            {% endcapture %}

            {% assign cart_drawer_title = 'content.cart_title' | t %}

            {% render 'theme-drawer-header',
              title: cart_drawer_title,
              drawer_id: 'cart-drawer',
              heading_id: 'cart-drawer-heading',
              title_append: cart_badge_html
            %}

          {%- endif -%}


          {% capture cart_items_children %}

            {%- if cart.empty? -%}

              {{ empty_cart_drawer_content }}

            {%- else -%}

              <scroll-hint
                class="cart-drawer__content"
                aria-label="{{ 'accessibility.cart' | t }}"
              >

                <scroll-hint class="cart-drawer__items">

                  {% render 'cart-products',
                    context: 'drawer'
                  %}

                </scroll-hint>


                <div class="cart-drawer__summary">

                  {% render 'cart-summary',
                    section_id: 'cart-drawer-section'
                  %}

                </div>

              </scroll-hint>

            {%- endif -%}

          {% endcapture %}


          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}

        </div>

      </cart-drawer-component>

    </dialog>

  </theme-drawer>


  {% if render_wrapper %}
    </div>
  {% endif %}

{%- endif -%}


{% stylesheet %}

/* =========================================================
   CART DRAWER
   ========================================================= */

cart-drawer-component {
  --cart-drawer-padding: var(--theme-drawer-padding);
  --font-paragraph--line-height: 1;

  display: contents;
}


/* =========================================================
   INNER
   ========================================================= */

.cart-drawer__inner {
  display: flex;
  flex-direction: column;

  height: 100%;

  overflow: hidden;
}


.cart-drawer__inner > .cart-items-component {
  flex: 1;

  min-height: 0;

  height: auto;
}


/* =========================================================
   CONTENT
   ========================================================= */

.cart-drawer__content {
  display: flex;
  flex-direction: column;

  padding: 0;

  background-color: var(--color-background);

  flex-grow: 1;

  overflow-y: auto;
}


/* =========================================================
   PRODUCTS
   ========================================================= */

.cart-drawer__items {
  display: flex;
  flex-direction: column;

  padding-inline: var(--cart-drawer-padding);

  overflow-y: auto;
}


.cart-drawer__items .cart-items__table-row {
  padding-bottom: var(--gap-xl);

  border-bottom:
    var(--style-border-width)
    solid
    rgb(
      var(--color-foreground-rgb) /
      var(--opacity-10-25)
    );

  margin-bottom: var(--gap-xl);
}


.cart-drawer__items
.cart-items__table-row:has(+ .cart-items__nested-line) {
  border-bottom: none;

  margin-bottom: 0;
}


.cart-drawer__items
.cart-items__table-row:last-child {
  border-bottom: none;

  padding-block-end: 0;

  margin-block-end: 0;
}


/* =========================================================
   CLOSE BUTTON
   ========================================================= */

.cart-drawer__close-button--empty {
  margin-inline-start: auto;
}


/* =========================================================
   CART SUMMARY
   ========================================================= */

.cart-drawer__summary {
  --cart-drawer-summary-padding: var(--padding-lg);

  position: sticky;

  bottom: 0;

  z-index: 10;

  display: flex;
  flex-direction: column;

  align-items: stretch;

  gap: 10px;

  width: 100%;

  padding:
    14px
    var(--cart-drawer-summary-padding)
    var(--cart-drawer-summary-padding);

  margin-top: auto;

  background-color: var(--color-background);

  mask-image:
    linear-gradient(
      to bottom,
      transparent,
      black 14px
    );
}


@media screen and (min-width: 750px) {

  .cart-drawer__summary {
    --cart-drawer-summary-padding: var(--padding-2xl);
  }

}


/* =========================================================
   NON STICKY SUMMARY
   ========================================================= */

.theme-drawer__dialog[cart-summary-sticky='false']
.cart-drawer__summary {

  position: static;

  mask-image: none;
}


.theme-drawer__dialog[cart-summary-sticky='false']
.cart-drawer__items {

  overflow: unset;
}


/* =========================================================
   REMOVE SPECIAL INSTRUCTIONS
   ========================================================= */

/*
  Hide cart note / special instructions
*/

.cart-drawer__summary .cart-note {
  display: none !important;
}


/*
  Some versions of the theme put the cart note
  inside cart-actions / details.
*/

.cart-drawer__summary .cart-actions {
  display: none !important;
}


/* =========================================================
   REMOVE DISCOUNT
   ========================================================= */

.cart-drawer__summary .cart-discount,
.cart-drawer__summary .discount,
.cart-drawer__summary .discount-code,
.cart-drawer__summary .cart__discount,
.cart-drawer__summary .cart-discount-field,
.cart-drawer__summary [class*="discount-code"] {
  display: none !important;
}


/* =========================================================
   REMOVE EXTRA DETAILS / ACCORDIONS
   ========================================================= */

.cart-drawer__summary details {
  display: none !important;
}


/* =========================================================
   TOTAL
   ========================================================= */

.cart-drawer__summary
.cart__summary-totals:not(
  :has(.cart__subtotal-container:empty)
) {

  border-block-start:
    var(--style-border-width)
    solid
    rgb(
      var(--color-foreground-rgb) /
      var(--opacity-10-25)
    );

  padding-block-start: 14px;

  margin-top: 0;

  margin-bottom: 0;
}


.cart-drawer__summary
.cart__subtotal-container {

  margin-bottom: 0;
}


/* =========================================================
   CHECKOUT AREA
   ========================================================= */

.cart-drawer__summary .cart__ctas,
.cart-drawer__summary .cart__checkout-buttons,
.cart-drawer__summary .cart__checkout,
.cart-drawer__summary [class*="checkout"] {

  width: 100%;

  margin-top: 0 !important;

  margin-bottom: 0 !important;
}


/* =========================================================
   PRIMARY CHECKOUT BUTTON
   ========================================================= */

.cart-drawer__summary button[name="checkout"],
.cart-drawer__summary .cart__checkout-button,
.cart-drawer__summary a[href="/checkout"],
.cart-drawer__summary a[href*="/checkout"] {

  width: 100% !important;

  min-height: 52px !important;

  padding: 14px 20px !important;

  display: flex !important;

  align-items: center !important;

  justify-content: center !important;

  text-align: center !important;


  border: none !important;

  border-radius:
    var(
      --style-border-radius-buttons-primary,
      8px
    ) !important;

  font: inherit;

  font-weight: 600 !important;

  line-height: 1.2;

  text-decoration: none !important;

  cursor: pointer;

  opacity: 1;

  transition:
    opacity 0.2s ease,
    transform 0.2s ease;
}


/* =========================================================
   CHECKOUT HOVER
   ========================================================= */

.cart-drawer__summary button[name="checkout"]:hover,
.cart-drawer__summary .cart__checkout-button:hover,
.cart-drawer__summary a[href="/checkout"]:hover,
.cart-drawer__summary a[href*="/checkout"]:hover {

  opacity: 0.9;

  transform: translateY(-1px);
}


/* =========================================================
   CHECKOUT ACTIVE
   ========================================================= */

.cart-drawer__summary button[name="checkout"]:active,
.cart-drawer__summary .cart__checkout-button:active,
.cart-drawer__summary a[href="/checkout"]:active,
.cart-drawer__summary a[href*="/checkout"]:active {

  transform: translateY(0);
}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {

  .cart-drawer__summary {

    --cart-drawer-summary-padding: 16px;

    padding-top: 10px;

    gap: 8px;
  }


  .cart-drawer__summary button[name="checkout"],
  .cart-drawer__summary .cart__checkout-button,
  .cart-drawer__summary a[href="/checkout"],
  .cart-drawer__summary a[href*="/checkout"] {

    min-height: 54px !important;

    font-size: 16px;
  }

}


/* =========================================================
   EMPTY CART
   ========================================================= */

.cart-drawer--empty .cart-drawer__content {

  text-align: center;

  align-items: center;

  justify-content: center;

  min-height: auto;
}


.cart-drawer--empty .cart-drawer__items {
  padding-inline: 0;
}


/* =========================================================
   NO CART FORM
   ========================================================= */

cart-drawer-component:not(:has(.cart-form))
.cart-drawer__content {

  text-align: center;

  align-items: center;

  justify-content: center;
}


cart-drawer-component:not(:has(.cart-form))
.cart-drawer__items {
  padding-inline: 0;
}


/* =========================================================
   ACCESSIBILITY / TRANSITIONS
   ========================================================= */

@media screen and (prefers-reduced-motion: no-preference) {

  html:active-view-transition-type(empty-cart-drawer) {

    .theme-drawer__close-button {
      view-transition-name: cart-drawer-close-button;
    }

  }

}


:active-view-transition {

  .cart-drawer__header,
  .cart-drawer__content {

    background: transparent;

  }

}

{% endstylesheet %}