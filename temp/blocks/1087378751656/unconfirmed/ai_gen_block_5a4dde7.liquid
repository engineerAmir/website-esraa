{% doc %}
  @prompt
    Create a **Scrollable Circular Collections Section** for my Shopify store.
    
    **Design & Layout:**
    - Display collections as circular images with collection names underneath.
    - Clean, modern, premium e-commerce design.
    - Perfectly round images (1:1 aspect ratio).
    - Horizontal scrollable carousel on desktop and mobile.
    - Smooth touch/swipe scrolling on mobile.
    - Each circle and collection name must be clickable and link to its collection page.
    - Automatically use the selected collection's featured image and title.
    
    **Desktop:**
    - Display 6–8 collection circles per view.
    - Enable horizontal scrolling with optional navigation arrows.
    - Keep all circles in a single row.
    
    **Mobile:**
    - Display 3–4 circles per view.
    - Allow horizontal swipe scrolling.
    - Hide navigation arrows.
    - Never wrap collections into multiple rows.
    
    **Shopify Theme Editor Settings:**
    - Add, remove, and reorder collections using blocks.
    - Collection picker for each block.
    - Custom image and title overrides.
    - Adjustable circle size for desktop and mobile.
    - Adjustable spacing between circles.
    - Section heading and optional subtitle.
    - Background color, text color, and typography controls.
    - Show/hide navigation arrows.
    - Adjustable section padding.
    
    **Requirements:**
    - Fully responsive.
    - Lightweight and optimized for PageSpeed.
    - Lazy-load images below the fold.
    - Smooth scrolling with CSS scroll-snap.
    - No external libraries.
    - Prevent layout shifts.
    - Compatible with Shopify Online Store 2.0.
    - All settings must work in the Shopify Theme Editor., center heading please 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-collections-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; padding:{{ block.settings.vertical_padding }}px 0; background:{{ block.settings.background_color }}; color:{{ block.settings.text_color }}; --circle-desktop:{{ block.settings.desktop_circle_size }}px; --circle-mobile:{{ block.settings.mobile_circle_size }}px; --circle-gap:{{ block.settings.item_gap }}px; }
  .ai-collections-{{ ai_gen_id }}__head { display:flex; flex-direction:column; align-items:center; text-align:center; gap:20px; margin:0 0 22px; }
  .ai-collections-{{ ai_gen_id }}__heading { margin:0; color:inherit; font-family:{{ block.settings.heading_font.family }},{{ block.settings.heading_font.fallback_families }}; font-weight:{{ block.settings.heading_font.weight }}; font-size:{{ block.settings.heading_size }}px; }
  .ai-collections-{{ ai_gen_id }}__subtitle { margin:6px 0 0; opacity:.82; font-size:14px; }
  .ai-collections-{{ ai_gen_id }}__controls { display:flex; gap:8px; flex-shrink:0; }
  .ai-collections-{{ ai_gen_id }}__arrow { width:40px; height:40px; display:grid; place-items:center; border:1px solid currentColor; border-radius:50%; background:transparent; color:inherit; cursor:pointer; }
  .ai-collections-{{ ai_gen_id }}__arrow:focus-visible,.ai-collections-{{ ai_gen_id }}__link:focus-visible { outline:2px solid currentColor; outline-offset:3px; }
  .ai-collections-{{ ai_gen_id }}__arrow svg { width:17px; height:17px; }
  .ai-collections-{{ ai_gen_id }}__track { display:flex; flex-wrap:nowrap; gap:var(--circle-gap); overflow-x:auto; overflow-y:hidden; scroll-snap-type:x mandatory; scroll-behavior:smooth; scrollbar-width:none; -webkit-overflow-scrolling:touch; }
  .ai-collections-{{ ai_gen_id }}__track::-webkit-scrollbar { display:none; }
  .ai-collections-{{ ai_gen_id }}__item { flex:0 0 var(--circle-desktop); min-width:0; text-align:center; scroll-snap-align:start; }
  .ai-collections-{{ ai_gen_id }}__link { display:block; color:inherit; text-decoration:none; }
  .ai-collections-{{ ai_gen_id }}__media { display:block; width:100%; aspect-ratio:1; overflow:hidden; border-radius:50%; background:#eee8e1; }
  .ai-collections-{{ ai_gen_id }}__media img { display:block; width:100%; height:100%; object-fit:cover; }
  .ai-collections-{{ ai_gen_id }}__placeholder { display:grid; place-items:center; width:100%; height:100%; }
  .ai-collections-{{ ai_gen_id }}__placeholder svg { width:55%; height:55%; color:#756b63; }
  .ai-collections-{{ ai_gen_id }}__title { display:block; margin-top:12px; color:inherit; font-size:14px; line-height:1.4; }
  @media(max-width:749px) { .ai-collections-{{ ai_gen_id }} { width:100%; padding:{{ block.settings.mobile_vertical_padding }}px 0; } .ai-collections-{{ ai_gen_id }}__track { gap:{{ block.settings.mobile_item_gap }}px; } .ai-collections-{{ ai_gen_id }}__item { flex-basis:var(--circle-mobile); } .ai-collections-{{ ai_gen_id }}__controls { display:none; } .ai-collections-{{ ai_gen_id }}__head { gap:0; margin-bottom:16px; } .ai-collections-{{ ai_gen_id }}__heading { font-size:{{ block.settings.mobile_heading_size }}px; } }
  @media(prefers-reduced-motion:reduce) { .ai-collections-{{ ai_gen_id }}__track { scroll-behavior:auto; } }
{% endstyle %}
<ai-collections-{{ ai_gen_id }} class="ai-collections-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank or block.settings.subtitle != blank %}<div class="ai-collections-{{ ai_gen_id }}__head"><div>{% if block.settings.heading != blank %}<h2 class="ai-collections-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}{% if block.settings.subtitle != blank %}<p class="ai-collections-{{ ai_gen_id }}__subtitle">{{ block.settings.subtitle | escape }}</p>{% endif %}</div>{% if block.settings.show_arrows %}<div class="ai-collections-{{ ai_gen_id }}__controls"><button class="ai-collections-{{ ai_gen_id }}__arrow" type="button" data-direction="previous" aria-label="Scroll collections left"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button><button class="ai-collections-{{ ai_gen_id }}__arrow" type="button" data-direction="next" aria-label="Scroll collections right"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button></div>{% endif %}</div>{% endif %}
  <div class="ai-collections-{{ ai_gen_id }}__track" tabindex="0" aria-label="Collections">
    {% for collection in block.settings.collections %}{% assign item_image = collection.image | default: collection.products.first.featured_image %}<div class="ai-collections-{{ ai_gen_id }}__item"><a class="ai-collections-{{ ai_gen_id }}__link" href="{{ collection.url }}" aria-label="{{ collection.title | escape }}"><span class="ai-collections-{{ ai_gen_id }}__media">{% if item_image %}<img src="{{ item_image | image_url: width: 500 }}" alt="{{ item_image.alt | default: collection.title | escape }}" width="{{ item_image.width }}" height="{{ item_image.height }}" loading="lazy">{% else %}<span class="ai-collections-{{ ai_gen_id }}__placeholder">{{ 'collection-apparel-1' | placeholder_svg_tag }}</span>{% endif %}</span><span class="ai-collections-{{ ai_gen_id }}__title">{{ collection.title | escape }}</span></a></div>{% else %}{% for i in (1..6) %}<div class="ai-collections-{{ ai_gen_id }}__item"><span class="ai-collections-{{ ai_gen_id }}__media"><span class="ai-collections-{{ ai_gen_id }}__placeholder">{{ 'collection-apparel-1' | placeholder_svg_tag }}</span></span><span class="ai-collections-{{ ai_gen_id }}__title">Choose collections</span></div>{% endfor %}{% endfor %}
  </div>
</ai-collections-{{ ai_gen_id }}>
<script>(()=>{if(customElements.get('ai-collections-{{ ai_gen_id }}'))return;class AICollections{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.track=this.querySelector('.ai-collections-{{ ai_gen_id }}__track');this.querySelectorAll('.ai-collections-{{ ai_gen_id }}__arrow').forEach(button=>button.addEventListener('click',()=>this.track.scrollBy({left:(button.dataset.direction==='next'?1:-1)*this.track.clientWidth*.75,behavior:'smooth'})))}}customElements.define('ai-collections-{{ ai_gen_id }}',AICollections{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Circular collections","settings":[{"type":"text","id":"heading","label":"Heading","default":"Explore collections"},{"type":"text","id":"subtitle","label":"Subtitle","default":"Discover the latest edits"},{"type":"collection_list","id":"collections","label":"Collections","limit":20},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"shippori_antique_n4"},{"type":"range","id":"heading_size","label":"Heading size","min":18,"max":48,"step":2,"unit":"px","default":28},{"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":16,"max":32,"step":2,"unit":"px","default":22},{"type":"range","id":"desktop_circle_size","label":"Desktop circle size","min":90,"max":180,"step":10,"unit":"px","default":130},{"type":"range","id":"mobile_circle_size","label":"Mobile circle size","min":72,"max":120,"step":6,"unit":"px","default":90},{"type":"range","id":"item_gap","label":"Desktop spacing","min":8,"max":40,"step":4,"unit":"px","default":20},{"type":"range","id":"mobile_item_gap","label":"Mobile spacing","min":8,"max":32,"step":4,"unit":"px","default":16},{"type":"checkbox","id":"show_arrows","label":"Show navigation arrows","default":true},{"type":"color","id":"background_color","label":"Background","default":"#F7F2EC"},{"type":"color","id":"text_color","label":"Text","default":"#2A2526"},{"type":"range","id":"vertical_padding","label":"Desktop vertical padding","min":0,"max":64,"step":4,"unit":"px","default":24},{"type":"range","id":"mobile_vertical_padding","label":"Mobile vertical padding","min":0,"max":48,"step":4,"unit":"px","default":20},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}],"presets":[{"name":"Circular collections"}],"tag":null,"class":"circular-collections-block"}{% endschema %}