{% doc %}
  @prompt
    shop by cate 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-shop-by-category-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 0;
    color: {{ block.settings.text_color }};
  }

  .ai-shop-by-category-{{ ai_gen_id }}__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }

  .ai-shop-by-category-{{ ai_gen_id }}__heading {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_heading_font.family }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.1;
  }

  .ai-shop-by-category-{{ ai_gen_id }}__intro {
    max-width: 480px;
    margin: 8px 0 0;
    color: {{ block.settings.muted_text_color }};
    font-family: {{ settings.type_body_font.family }};
    font-size: 14px;
    line-height: 1.5;
  }

  .ai-shop-by-category-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-shop-by-category-{{ ai_gen_id }}__card {
    position: relative;
    display: block;
    overflow: hidden;
    min-height: 260px;
    border-radius: {{ block.settings.card_radius }}px;
    background: {{ block.settings.card_background }};
    color: {{ block.settings.card_text_color }};
    text-decoration: none;
  }

  .ai-shop-by-category-{{ ai_gen_id }}__media,
  .ai-shop-by-category-{{ ai_gen_id }}__media img,
  .ai-shop-by-category-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ai-shop-by-category-{{ ai_gen_id }}__media {
    position: absolute;
    inset: 0;
  }

  .ai-shop-by-category-{{ ai_gen_id }}__media img {
    object-fit: cover;
  }

  .ai-shop-by-category-{{ ai_gen_id }}__media svg {
    background: #e9dadb;
    fill: #6d263d;
  }

  .ai-shop-by-category-{{ ai_gen_id }}__overlay {
    position: absolute;
    inset: 45% 0 0;
    display: flex;
    align-items: end;
    padding: 22px;
    background: linear-gradient(transparent, rgba(28, 28, 24, 0.82));
  }

  .ai-shop-by-category-{{ ai_gen_id }}__title {
    margin: 0;
    font-family: {{ settings.type_subheading_font.family }};
    font-size: 20px;
    line-height: 1.2;
  }

  .ai-shop-by-category-{{ ai_gen_id }}__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    margin-left: 10px;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 18px;
  }

  .ai-shop-by-category-{{ ai_gen_id }}__card:focus-visible {
    outline: 3px solid {{ block.settings.text_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-shop-by-category-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding }}px 0;
    }

    .ai-shop-by-category-{{ ai_gen_id }}__header {
      display: block;
      margin-bottom: 20px;
    }

    .ai-shop-by-category-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-shop-by-category-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-shop-by-category-{{ ai_gen_id }}__card {
      min-height: 210px;
    }
  }
{% endstyle %}

<div class="ai-shop-by-category-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-shop-by-category-{{ ai_gen_id }}__header">
    <div>
      {% if block.settings.heading != blank %}
        <h2 class="ai-shop-by-category-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <p class="ai-shop-by-category-{{ ai_gen_id }}__intro">{{ block.settings.description | escape }}</p>
      {% endif %}
    </div>
  </div>

  {% if block.settings.collections != blank %}
    <div class="ai-shop-by-category-{{ ai_gen_id }}__grid">
      {% for collection in block.settings.collections %}
        <a class="ai-shop-by-category-{{ ai_gen_id }}__card" href="{{ collection.url }}" aria-label="Shop {{ collection.title | escape }}">
          <div class="ai-shop-by-category-{{ ai_gen_id }}__media">
            {% if collection.featured_image %}
              <img src="{{ collection.featured_image | image_url: width: 900 }}" alt="{{ collection.featured_image.alt | default: collection.title | escape }}" loading="lazy" width="900" height="900">
            {% else %}
              {{ 'collection-apparel-1' | placeholder_svg_tag }}
            {% endif %}
          </div>
          <div class="ai-shop-by-category-{{ ai_gen_id }}__overlay">
            <span class="ai-shop-by-category-{{ ai_gen_id }}__title">{{ collection.title | escape }} <span class="ai-shop-by-category-{{ ai_gen_id }}__arrow" aria-hidden="true">→</span></span>
          </div>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-shop-by-category-{{ ai_gen_id }}__grid">
      {% for i in (1..4) %}
        <div class="ai-shop-by-category-{{ ai_gen_id }}__card">
          <div class="ai-shop-by-category-{{ ai_gen_id }}__media">{{ 'collection-apparel-1' | placeholder_svg_tag }}</div>
          <div class="ai-shop-by-category-{{ ai_gen_id }}__overlay"><span class="ai-shop-by-category-{{ ai_gen_id }}__title">Select a collection</span></div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Shop by category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Explore our latest collections, designed for every occasion."
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Categories",
      "limit": 8
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile heading size",
      "min": 18,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 8,
      "max": 24,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section spacing",
      "min": 0,
      "max": 80,
      "step": 8,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_padding",
      "label": "Mobile spacing",
      "min": 0,
      "max": 48,
      "step": 8,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#6d263d"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text",
      "default": "#6d263d"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#e9dadb"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Shop by category"
    }
  ],
  "tag": null,
  "class": "shop-by-category-block"
}
{% endschema %}