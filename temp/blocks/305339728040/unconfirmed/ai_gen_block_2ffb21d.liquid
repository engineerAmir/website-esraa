{% doc %}
  @prompt
    Create a premium responsive Contact Us section for “Esraa Fashion Designer”, an Egyptian modest womenswear fashion brand.
    
    Match the website’s luxury editorial style: warm neutral background, elegant serif headings, clean sans-serif text, generous whitespace, thin borders, feminine minimal design and subtle animations. Avoid generic cards, heavy shadows and excessive rounded corners.
    
    Hero:
    Small label: “GET IN TOUCH”
    Heading: “We’d Love to Hear From You.”
    Text: “Questions about an order, sizing, our collections or a custom mother-and-daughter look? Our team is here to help.”
    
    Create a 2-column desktop layout.
    
    Left:
    Heading: “Let’s Talk”
    Add contact methods with minimal icons:
    WhatsApp: 01101129288
    Button: “CHAT ON WHATSAPP”
    Link: https://wa.me/201101129288
    
    Add:
    Instagram — Esraa Fashion Designer
    Instagram — Meet Esraa
    Facebook
    
    Right:
    Elegant contact form with:
    Name
    Email
    Phone
    Subject
    Message
    Submit button: “SEND MESSAGE”
    
    Add a small section:
    “Looking for Something Special?”
    Text about custom designs and matching mother-and-daughter outfits.
    CTA: “ASK ABOUT CUSTOMIZATION” linked to WhatsApp.
    
    Use Shopify Liquid and {% schema %}. Make headings, text, social links, WhatsApp, colors and spacing editable in Theme Editor. Fully responsive, mobile-first, no external libraries.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-contact-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;padding:{{ block.settings.section_padding }}px 5%;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }}}.ai-contact-{{ ai_gen_id }}__inner{max-width:1180px;margin:0 auto}.ai-contact-{{ ai_gen_id }}__eyebrow{margin:0 0 18px;color:{{ block.settings.accent_color }};font:600 11px/1.4 {{ block.settings.body_font.family }};letter-spacing:.18em}.ai-contact-{{ ai_gen_id }}__hero{max-width:700px;margin-bottom:70px}.ai-contact-{{ ai_gen_id }}__title,.ai-contact-{{ ai_gen_id }}__heading{font-family:{{ block.settings.heading_font.family }};font-weight:400;letter-spacing:-.02em}.ai-contact-{{ ai_gen_id }}__title{margin:0 0 22px;font-size:clamp(38px,6vw,72px);line-height:1.05}.ai-contact-{{ ai_gen_id }}__intro,.ai-contact-{{ ai_gen_id }}__copy{margin:0;font:400 16px/1.8 {{ block.settings.body_font.family }}}.ai-contact-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:12%}.ai-contact-{{ ai_gen_id }}__heading{margin:0 0 28px;font-size:34px;line-height:1.2}.ai-contact-{{ ai_gen_id }}__method{padding-bottom:28px;margin-bottom:28px;border-bottom:1px solid {{ block.settings.border_color }}}.ai-contact-{{ ai_gen_id }}__method-label{margin-bottom:8px;font:600 12px/1.4 {{ block.settings.body_font.family }};letter-spacing:.1em;text-transform:uppercase}.ai-contact-{{ ai_gen_id }}__phone,.ai-contact-{{ ai_gen_id }}__social{color:{{ block.settings.text_color }};text-decoration:none;font:400 15px/1.5 {{ block.settings.body_font.family }}}.ai-contact-{{ ai_gen_id }}__button,.ai-contact-{{ ai_gen_id }}__submit{display:inline-flex;justify-content:center;align-items:center;min-height:48px;padding:12px 22px;border:1px solid {{ block.settings.button_color }};background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};font:600 11px/1.2 {{ block.settings.body_font.family }};letter-spacing:.12em;text-decoration:none;cursor:pointer;transition:opacity .2s ease,transform .2s ease}.ai-contact-{{ ai_gen_id }}__button{margin-top:18px}.ai-contact-{{ ai_gen_id }}__button:hover,.ai-contact-{{ ai_gen_id }}__submit:hover{opacity:.82;transform:translateY(-2px)}.ai-contact-{{ ai_gen_id }}__socials{display:grid;gap:14px}.ai-contact-{{ ai_gen_id }}__social{border-bottom:1px solid {{ block.settings.border_color }};padding-bottom:12px}.ai-contact-{{ ai_gen_id }}__form{display:grid;gap:24px}.ai-contact-{{ ai_gen_id }}__fields{display:grid;grid-template-columns:1fr 1fr;gap:24px}.ai-contact-{{ ai_gen_id }}__field{display:grid;gap:9px}.ai-contact-{{ ai_gen_id }}__label{font:600 11px/1.3 {{ block.settings.body_font.family }};letter-spacing:.1em;text-transform:uppercase}.ai-contact-{{ ai_gen_id }}__input{width:100%;box-sizing:border-box;padding:13px 0;border:0;border-bottom:1px solid {{ block.settings.border_color }};border-radius:0;background:transparent;color:{{ block.settings.text_color }};font:400 15px/1.5 {{ block.settings.body_font.family }}}.ai-contact-{{ ai_gen_id }}__input:focus{outline:2px solid {{ block.settings.accent_color }};outline-offset:4px}.ai-contact-{{ ai_gen_id }}__textarea{min-height:120px;resize:vertical}.ai-contact-{{ ai_gen_id }}__custom{margin-top:75px;padding-top:28px;border-top:1px solid {{ block.settings.border_color }}}.ai-contact-{{ ai_gen_id }}__custom .ai-contact-{{ ai_gen_id }}__heading{font-size:27px;margin-bottom:14px}@media(max-width:749px){.ai-contact-{{ ai_gen_id }}{padding:{{ block.settings.mobile_padding }}px 6%}.ai-contact-{{ ai_gen_id }}__hero{margin-bottom:48px}.ai-contact-{{ ai_gen_id }}__grid{grid-template-columns:1fr;gap:58px}.ai-contact-{{ ai_gen_id }}__fields{grid-template-columns:1fr;gap:24px}}
{% endstyle %}
<esraa-contact-{{ ai_gen_id }} class="ai-contact-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-contact-{{ ai_gen_id }}__inner"><header class="ai-contact-{{ ai_gen_id }}__hero"><p class="ai-contact-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p><h1 class="ai-contact-{{ ai_gen_id }}__title">{{ block.settings.title }}</h1><p class="ai-contact-{{ ai_gen_id }}__intro">{{ block.settings.intro }}</p></header><div class="ai-contact-{{ ai_gen_id }}__grid"><div><h2 class="ai-contact-{{ ai_gen_id }}__heading">{{ block.settings.left_heading }}</h2><div class="ai-contact-{{ ai_gen_id }}__method"><div class="ai-contact-{{ ai_gen_id }}__method-label">◌ {{ block.settings.whatsapp_label }}</div><a class="ai-contact-{{ ai_gen_id }}__phone" href="tel:{{ block.settings.whatsapp_number | remove: ' ' }}">{{ block.settings.whatsapp_number }}</a><br><a class="ai-contact-{{ ai_gen_id }}__button" href="{{ block.settings.whatsapp_url }}" target="_blank" rel="noopener">{{ block.settings.whatsapp_button }}</a></div><nav class="ai-contact-{{ ai_gen_id }}__socials" aria-label="Social links"><a class="ai-contact-{{ ai_gen_id }}__social" href="{{ block.settings.instagram_esraa_url }}">{{ block.settings.instagram_esraa_label }}</a><a class="ai-contact-{{ ai_gen_id }}__social" href="{{ block.settings.instagram_meet_url }}">{{ block.settings.instagram_meet_label }}</a><a class="ai-contact-{{ ai_gen_id }}__social" href="{{ block.settings.facebook_url }}">{{ block.settings.facebook_label }}</a></nav><div class="ai-contact-{{ ai_gen_id }}__custom"><h2 class="ai-contact-{{ ai_gen_id }}__heading">{{ block.settings.custom_heading }}</h2><p class="ai-contact-{{ ai_gen_id }}__copy">{{ block.settings.custom_text }}</p><a class="ai-contact-{{ ai_gen_id }}__button" href="{{ block.settings.whatsapp_url }}" target="_blank" rel="noopener">{{ block.settings.custom_button }}</a></div></div><div class="ai-contact-{{ ai_gen_id }}__form">{% form 'contact' %}<div class="ai-contact-{{ ai_gen_id }}__fields"><label class="ai-contact-{{ ai_gen_id }}__field"><span class="ai-contact-{{ ai_gen_id }}__label">Name</span><input class="ai-contact-{{ ai_gen_id }}__input" type="text" name="contact[name]" required autocomplete="name"></label><label class="ai-contact-{{ ai_gen_id }}__field"><span class="ai-contact-{{ ai_gen_id }}__label">Email</span><input class="ai-contact-{{ ai_gen_id }}__input" type="email" name="contact[email]" required autocomplete="email"></label></div><div class="ai-contact-{{ ai_gen_id }}__fields"><label class="ai-contact-{{ ai_gen_id }}__field"><span class="ai-contact-{{ ai_gen_id }}__label">Phone</span><input class="ai-contact-{{ ai_gen_id }}__input" type="tel" name="contact[phone]"></label><label class="ai-contact-{{ ai_gen_id }}__field"><span class="ai-contact-{{ ai_gen_id }}__label">Subject</span><input class="ai-contact-{{ ai_gen_id }}__input" type="text" name="contact[subject]"></label></div><label class="ai-contact-{{ ai_gen_id }}__field"><span class="ai-contact-{{ ai_gen_id }}__label">Message</span><textarea class="ai-contact-{{ ai_gen_id }}__input ai-contact-{{ ai_gen_id }}__textarea" name="contact[body]" required></textarea></label><button class="ai-contact-{{ ai_gen_id }}__submit" type="submit">{{ block.settings.submit_label }}</button>{% if form.posted_successfully? %}<p role="status">{{ block.settings.success_message }}</p>{% endif %}{% if form.errors %}<p role="alert">{{ form.errors | default_errors }}</p>{% endif %}{% endform %}</div></div></div></esraa-contact-{{ ai_gen_id }}>
{% schema %}{"name":"Contact us editorial","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"GET IN TOUCH"},{"type":"text","id":"title","label":"Heading","default":"We’d Love to Hear From You."},{"type":"textarea","id":"intro","label":"Intro text","default":"Questions about an order, sizing, our collections or a custom mother-and-daughter look? Our team is here to help."},{"type":"text","id":"left_heading","label":"Contact heading","default":"Let’s Talk"},{"type":"text","id":"whatsapp_label","label":"WhatsApp label","default":"WhatsApp"},{"type":"text","id":"whatsapp_number","label":"WhatsApp number","default":"01101129288"},{"type":"url","id":"whatsapp_url","label":"WhatsApp link"},{"type":"text","id":"whatsapp_button","label":"WhatsApp button","default":"CHAT ON WHATSAPP"},{"type":"text","id":"instagram_esraa_label","label":"Instagram label","default":"Instagram — Esraa Fashion Designer"},{"type":"url","id":"instagram_esraa_url","label":"Instagram link"},{"type":"text","id":"instagram_meet_label","label":"Instagram label","default":"Instagram — Meet Esraa"},{"type":"url","id":"instagram_meet_url","label":"Instagram link"},{"type":"text","id":"facebook_label","label":"Facebook label","default":"Facebook"},{"type":"url","id":"facebook_url","label":"Facebook link"},{"type":"text","id":"custom_heading","label":"Custom heading","default":"Looking for Something Special?"},{"type":"textarea","id":"custom_text","label":"Custom text","default":"We create thoughtful custom designs and matching mother-and-daughter outfits made especially for you."},{"type":"text","id":"custom_button","label":"Custom button","default":"ASK ABOUT CUSTOMIZATION"},{"type":"text","id":"submit_label","label":"Submit button","default":"SEND MESSAGE"},{"type":"text","id":"success_message","label":"Success message","default":"Thank you. We’ll be in touch shortly."},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"shippori_antique_n4"},{"type":"font_picker","id":"body_font","label":"Body font","default":"comfortaa_n4"},{"type":"color","id":"background_color","label":"Background","default":"#f7f2ec"},{"type":"color","id":"text_color","label":"Text","default":"#2a2526"},{"type":"color","id":"accent_color","label":"Accent","default":"#6d263d"},{"type":"color","id":"border_color","label":"Borders","default":"#d8c8c1"},{"type":"color","id":"button_color","label":"Button background","default":"#6d263d"},{"type":"color","id":"button_text_color","label":"Button text","default":"#f7f2ec"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"section_padding","label":"Desktop spacing","min":40,"max":160,"step":10,"unit":"px","default":100},{"type":"range","id":"mobile_padding","label":"Mobile spacing","min":24,"max":80,"step":8,"unit":"px","default":48}],"presets":[{"name":"Contact us editorial"}],"tag":null,"class":"contact-editorial-block"}{% endschema %}