{% doc %}
  @prompt
    create hersontal scroll circles for clooections 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-circles-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
  }

  .ai-collection-circles-{{ ai_gen_id }}__heading {
    margin: 0 0 20px;
    font-family: {{ block.settings.heading_font.family }};
    font-size: {{ block.settings.heading_size }}px;
    text-align: {{ block.settings.alignment }};
  }

  .ai-collection-circles-{{ ai_gen_id }}__viewport {
    position: relative;
  }

  .ai-collection-circles-{{ ai_gen_id }}__list {
    display: flex;
    gap: {{ block.settings.gap }}px;
    overflow-x: auto;
    padding: 4px 2px 12px;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: {{ block.settings.text_color }} transparent;
  }

  .ai-collection-circles-{{ ai_gen_id }}__item {
    flex: 0 0 {{ block.settings.circle_size }}px;
    scroll-snap-align: start;
    text-align: center;
  }

  .ai-collection-circles-{{ ai_gen_id }}__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .ai-collection-circles-{{ ai_gen_id }}__image,
  .ai-collection-circles-{{ ai_gen_id }}__placeholder {
    display: block;
    width: {{ block.settings.circle_size }}px;
    height: {{ block.settings.circle_size }}px;
    overflow: hidden;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: 50%;
    background: {{ block.settings.placeholder_color }};
  }

  .ai-collection-circles-{{ ai_gen_id }}__image {
    object-fit: cover;
  }

  .ai-collection-circles-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
  }

  .ai-collection-circles-{{ ai_gen_id }}__title {
    display: block;
    margin-top: 10px;
    font-family: {{ block.settings.body_font.family }};
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .ai-collection-circles-{{ ai_gen_id }}__control {
    position: absolute;
    top: calc({{ block.settings.circle_size }}px / 2 - 18px);
    z-index: 1;
    width: 36px;
    height: 36px;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: 50%;
    background: {{ block.settings.control_background }};
    color: {{ block.settings.control_color }};
    cursor: pointer;
    font-size: 22px;
    line-height: 1;
  }

  .ai-collection-circles-{{ ai_gen_id }}__control--previous { left: 8px; }
  .ai-collection-circles-{{ ai_gen_id }}__control--next { right: 8px; }

  @media screen and (max-width: 749px) {
    .ai-collection-circles-{{ ai_gen_id }}__item {
      flex-basis: {{ block.settings.mobile_circle_size }}px;
    }

    .ai-collection-circles-{{ ai_gen_id }}__image,
    .ai-collection-circles-{{ ai_gen_id }}__placeholder {
      width: {{ block.settings.mobile_circle_size }}px;
      height: {{ block.settings.mobile_circle_size }}px;
    }

    .ai-collection-circles-{{ ai_gen_id }}__control {
      top: calc({{ block.settings.mobile_circle_size }}px / 2 - 18px);
    }
  }
{% endstyle %}

<collection-circles-{{ ai_gen_id }} class="ai-collection-circles-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-collection-circles-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}
  <div class="ai-collection-circles-{{ ai_gen_id }}__viewport">
    <button type="button" class="ai-collection-circles-{{ ai_gen_id }}__control ai-collection-circles-{{ ai_gen_id }}__control--previous" aria-label="Previous collections">‹</button>
    <div class="ai-collection-circles-{{ ai_gen_id }}__list" data-list>
      {% for collection in block.settings.collections %}
        <div class="ai-collection-circles-{{ ai_gen_id }}__item">
          <a class="ai-collection-circles-{{ ai_gen_id }}__link" href="{{ collection.url }}" aria-label="View {{ collection.title | escape }} collection">
            {% if collection.image %}
              <img class="ai-collection-circles-{{ ai_gen_id }}__image" src="{{ collection.image | image_url: width: 500 }}" alt="{{ collection.image.alt | default: collection.title | escape }}" loading="lazy" width="{{ block.settings.circle_size }}" height="{{ block.settings.circle_size }}">
            {% else %}
              <div class="ai-collection-circles-{{ ai_gen_id }}__placeholder">{{ 'collection-apparel-1' | placeholder_svg_tag }}</div>
            {% endif %}
            <span class="ai-collection-circles-{{ ai_gen_id }}__title">{{ collection.title | escape }}</span>
          </a>
        </div>
      {% endfor %}
    </div>
    <button type="button" class="ai-collection-circles-{{ ai_gen_id }}__control ai-collection-circles-{{ ai_gen_id }}__control--next" aria-label="Next collections">›</button>
  </div>
</collection-circles-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionCircles{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.list = this.querySelector('[data-list]');
        this.previous = this.querySelector('.ai-collection-circles-{{ ai_gen_id }}__control--previous');
        this.next = this.querySelector('.ai-collection-circles-{{ ai_gen_id }}__control--next');
        this.previous.addEventListener('click', () => this.list.scrollBy({ left: -this.list.clientWidth * 0.75, behavior: 'smooth' }));
        this.next.addEventListener('click', () => this.list.scrollBy({ left: this.list.clientWidth * 0.75, behavior: 'smooth' }));
        this.updateControls();
        this.list.addEventListener('scroll', () => this.updateControls(), { passive: true });
      }

      updateControls() {
        this.previous.hidden = this.list.scrollLeft <= 2;
        this.next.hidden = this.list.scrollLeft + this.list.clientWidth >= this.list.scrollWidth - 2;
      }
    }

    if (!customElements.get('collection-circles-{{ ai_gen_id }}')) {
      customElements.define('collection-circles-{{ ai_gen_id }}', CollectionCircles{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Collection circles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by collection" },
    { "type": "collection_list", "id": "collections", "label": "Collections", "limit": 12 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "shippori_antique_n4" },
    { "type": "font_picker", "id": "body_font", "label": "Title font", "default": "comfortaa_n4" },
    { "type": "select", "id": "alignment", "label": "Alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "center" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 16, "max": 48, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "title_size", "label": "Title size", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "circle_size", "label": "Circle size", "min": 100, "max": 260, "step": 10, "unit": "px", "default": 170 },
    { "type": "range", "id": "mobile_circle_size", "label": "Mobile circle size", "min": 80, "max": 180, "step": 10, "unit": "px", "default": 120 },
    { "type": "range", "id": "gap", "label": "Spacing", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "border_width", "label": "Border width", "min": 0, "max": 5, "step": 1, "unit": "px", "default": 1 },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#6d263d" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#6d263d" },
    { "type": "color", "id": "placeholder_color", "label": "Placeholder", "default": "#e9dadb" },
    { "type": "color", "id": "control_background", "label": "Control background", "default": "#f7f2ec" },
    { "type": "color", "id": "control_color", "label": "Control icon", "default": "#6d263d" }
  ],
  "presets": [{ "name": "Collection circles" }],
  "tag": null,
  "class": "collection-circles-block"
}
{% endschema %}