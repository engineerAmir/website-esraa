{% doc %}
  @prompt
    herzontal scroll circils for collections links 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-collection-scroll-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; color:{{ block.settings.text_color }}; }
  .ai-collection-scroll__heading-{{ ai_gen_id }} { margin:0 0 20px; text-align:{{ block.settings.heading_alignment }}; font-size:{{ block.settings.heading_size }}px; line-height:1.2; color:{{ block.settings.text_color }}; }
  .ai-collection-scroll__track-{{ ai_gen_id }} { display:flex; gap:{{ block.settings.item_gap }}px; overflow-x:auto; padding:4px 2px 12px; margin:0; list-style:none; scrollbar-width:thin; scrollbar-color:{{ block.settings.text_color }} transparent; }
  .ai-collection-scroll__track-{{ ai_gen_id }}::-webkit-scrollbar { height:5px; }
  .ai-collection-scroll__track-{{ ai_gen_id }}::-webkit-scrollbar-thumb { background:{{ block.settings.text_color }}; border-radius:10px; }
  .ai-collection-scroll__item-{{ ai_gen_id }} { flex:0 0 {{ block.settings.circle_size }}px; text-align:center; }
  .ai-collection-scroll__link-{{ ai_gen_id }} { display:block; color:inherit; text-decoration:none; }
  .ai-collection-scroll__image-{{ ai_gen_id }}, .ai-collection-scroll__placeholder-{{ ai_gen_id }} { display:block; width:{{ block.settings.circle_size }}px; height:{{ block.settings.circle_size }}px; border-radius:50%; overflow:hidden; border:{{ block.settings.border_width }}px solid {{ block.settings.border_color }}; background:{{ block.settings.placeholder_color }}; box-sizing:border-box; }
  .ai-collection-scroll__image-{{ ai_gen_id }} { object-fit:cover; }
  .ai-collection-scroll__placeholder-{{ ai_gen_id }} svg { width:100%; height:100%; display:block; }
  .ai-collection-scroll__title-{{ ai_gen_id }} { display:block; margin-top:10px; font-size:{{ block.settings.label_size }}px; line-height:1.3; overflow-wrap:anywhere; }
  .ai-collection-scroll__link-{{ ai_gen_id }}:focus-visible { outline:2px solid {{ block.settings.text_color }}; outline-offset:4px; border-radius:4px; }
  @media screen and (max-width:749px) { .ai-collection-scroll__heading-{{ ai_gen_id }} { font-size:{{ block.settings.mobile_heading_size }}px; } .ai-collection-scroll__item-{{ ai_gen_id }} { flex-basis:{{ block.settings.mobile_circle_size }}px; } .ai-collection-scroll__image-{{ ai_gen_id }}, .ai-collection-scroll__placeholder-{{ ai_gen_id }} { width:{{ block.settings.mobile_circle_size }}px; height:{{ block.settings.mobile_circle_size }}px; } }
{% endstyle %}
<div class="ai-collection-scroll-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h2 class="ai-collection-scroll__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>{% endif %}
  {% if block.settings.collections != blank %}
    <ul class="ai-collection-scroll__track-{{ ai_gen_id }}" aria-label="{{ block.settings.heading | default: 'Collections' | escape }}">
      {% for collection in block.settings.collections %}
        <li class="ai-collection-scroll__item-{{ ai_gen_id }}"><a class="ai-collection-scroll__link-{{ ai_gen_id }}" href="{{ collection.url }}" aria-label="View {{ collection.title | escape }} collection">
          {% if collection.image %}<img class="ai-collection-scroll__image-{{ ai_gen_id }}" src="{{ collection.image | image_url: width: 400 }}" alt="{{ collection.image.alt | default: collection.title | escape }}" width="{{ block.settings.circle_size }}" height="{{ block.settings.circle_size }}" loading="lazy">{% else %}<span class="ai-collection-scroll__placeholder-{{ ai_gen_id }}">{{ 'collection-apparel-1' | placeholder_svg_tag }}</span>{% endif %}
          <span class="ai-collection-scroll__title-{{ ai_gen_id }}">{{ collection.title | escape }}</span>
        </a></li>
      {% endfor %}
    </ul>
  {% else %}<div class="ai-collection-scroll__track-{{ ai_gen_id }}"><p>Select collections in the block settings to display them here.</p></div>{% endif %}
</div>
{% schema %}
{
  "name":"Collection circles",
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"Shop collections"},
    {"type":"collection_list","id":"collections","label":"Collections","limit":12},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"select","id":"heading_alignment","label":"Heading alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"center"},
    {"type":"range","id":"heading_size","label":"Heading size","min":16,"max":40,"step":2,"unit":"px","default":24},
    {"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":14,"max":32,"step":2,"unit":"px","default":20},
    {"type":"range","id":"circle_size","label":"Circle size","min":60,"max":180,"step":10,"unit":"px","default":110},
    {"type":"range","id":"mobile_circle_size","label":"Mobile circle size","min":50,"max":140,"step":10,"unit":"px","default":80},
    {"type":"range","id":"item_gap","label":"Space between items","min":8,"max":40,"step":4,"unit":"px","default":20},
    {"type":"range","id":"label_size","label":"Label size","min":10,"max":20,"step":1,"unit":"px","default":14},
    {"type":"range","id":"border_width","label":"Border width","min":0,"max":6,"step":1,"unit":"px","default":1},
    {"type":"color","id":"border_color","label":"Border","default":"#6d263d"},
    {"type":"color","id":"text_color","label":"Text","default":"#6d263d"},
    {"type":"color","id":"placeholder_color","label":"Placeholder","default":"#e9dadb"}
  ],
  "presets":[{"name":"Collection circles"}],
  "tag":null,
  "class":"collection-circles-block"
}
{% endschema %}