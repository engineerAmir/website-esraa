{% doc %}
  @prompt
    slide show with left side blured 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% style %}.ai-ss-{{ ai_gen_id }}{display:block;position:relative;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;overflow:hidden;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }} }.ai-ss-{{ ai_gen_id }}__track{display:flex}.ai-ss-{{ ai_gen_id }}__slide{position:relative;flex:0 0 100%;min-height:{{ block.settings.slide_height }}px;display:flex;align-items:center}.ai-ss-{{ ai_gen_id }}__media,.ai-ss-{{ ai_gen_id }}__placeholder{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.ai-ss-{{ ai_gen_id }}__placeholder{display:flex;align-items:center;justify-content:center;background:#eadfd8}.ai-ss-{{ ai_gen_id }}__placeholder svg{width:50%;height:50%}.ai-ss-{{ ai_gen_id }}__blur{position:absolute;z-index:2;inset:-8% auto -8% -6%;width:{{ block.settings.blur_width }}%;background:{{ block.settings.blur_color }};opacity:{{ block.settings.blur_opacity | divided_by:100.0 }};filter:blur({{ block.settings.blur_amount }}px);transform:skewX(-8deg)}.ai-ss-{{ ai_gen_id }}__content{position:relative;z-index:3;width:42%;margin-left:8%;padding:40px 0}.ai-ss-{{ ai_gen_id }} h2{margin:0 0 16px;color:{{ block.settings.text_color }};font-family:{{ block.settings.heading_font.family }};font-size:{{ block.settings.heading_size }}px}.ai-ss-{{ ai_gen_id }} p{color:{{ block.settings.text_color }};line-height:1.5}.ai-ss-{{ ai_gen_id }} a{display:inline-block;padding:12px 24px;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};text-decoration:none;border-radius:{{ block.settings.button_radius }}px}.ai-ss-{{ ai_gen_id }}__controls{position:absolute;z-index:4;right:20px;bottom:20px;display:flex;gap:8px}.ai-ss-{{ ai_gen_id }} button{width:38px;height:38px;border:1px solid {{ block.settings.text_color }};border-radius:50%;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }}}@media(max-width:749px){.ai-ss-{{ ai_gen_id }}__slide{min-height:{{ block.settings.mobile_height }}px}.ai-ss-{{ ai_gen_id }}__content{width:70%}.ai-ss-{{ ai_gen_id }} h2{font-size:{{ block.settings.mobile_heading_size }}px}}{% endstyle %}<fashion-slideshow-{{ ai_gen_id }} class="ai-ss-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-ss-{{ ai_gen_id }}__track">{% for i in (1..3) %}{% assign image_key='slide_'|append:i|append:'_image' %}{% assign heading_key='slide_'|append:i|append:'_heading' %}{% assign text_key='slide_'|append:i|append:'_text' %}{% assign link_key='slide_'|append:i|append:'_link' %}{% if block.settings[image_key] %}<img class="ai-ss-{{ ai_gen_id }}__media" src="{{ block.settings[image_key] | image_url: width: 2000 }}" alt="{{ block.settings[image_key].alt | escape }}">{% else %}<div class="ai-ss-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}<div class="ai-ss-{{ ai_gen_id }}__blur"></div><div class="ai-ss-{{ ai_gen_id }}__content"><h2>{{ block.settings[heading_key] }}</h2><p>{{ block.settings[text_key] }}</p>{% if block.settings[link_key] %}<a href="{{ block.settings[link_key] }}">{{ block.settings.button_label }}</a>{% endif %}</div>{% endfor %}</div><div class="ai-ss-{{ ai_gen_id }}__controls"><button type="button" data-dir="prev" aria-label="Previous slide">←</button><button type="button" data-dir="next" aria-label="Next slide">→</button></div></fashion-slideshow-{{ ai_gen_id }}><script>(function(){class S{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.t=this.querySelector('.ai-ss-{{ ai_gen_id }}__track');this.i=0;this.querySelectorAll('[data-dir]').forEach(b=>b.onclick=()=>{this.i=(this.i+(b.dataset.dir==='next'?1:2))%3;this.t.style.transform='translateX(-'+this.i*100+'%)';this.t.style.transition='transform .4s ease'})}}customElements.define('fashion-slideshow-{{ ai_gen_id }}',S{{ ai_gen_id }})})()</script>{% schema %}{"name":"Blurred side slideshow","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"slide_height","label":"Slide height","min":300,"max":800,"step":25,"unit":"px","default":550},{"type":"range","id":"mobile_height","label":"Mobile height","min":280,"max":700,"step":20,"unit":"px","default":500},{"type":"color","id":"background_color","label":"Background","default":"#f7f2ec"},{"type":"color","id":"text_color","label":"Text","default":"#ffffff"},{"type":"color","id":"blur_color","label":"Blur color","default":"#6d263d"},{"type":"range","id":"blur_width","label":"Blur width","min":20,"max":70,"step":5,"unit":"%","default":40},{"type":"range","id":"blur_amount","label":"Blur amount","min":4,"max":40,"step":2,"unit":"px","default":18},{"type":"range","id":"blur_opacity","label":"Blur opacity","min":20,"max":100,"step":5,"unit":"%","default":80},{"type":"color","id":"button_color","label":"Button","default":"#6d263d"},{"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"shippori_antique_n4"},{"type":"range","id":"heading_size","label":"Heading size","min":24,"max":80,"step":4,"unit":"px","default":56},{"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":20,"max":52,"step":4,"unit":"px","default":36},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":30,"step":2,"unit":"px","default":4},{"type":"text","id":"button_label","label":"Button label","default":"Shop now"},{"type":"image_picker","id":"slide_1_image","label":"Slide 1 image"},{"type":"text","id":"slide_1_heading","label":"Slide 1 heading","default":"Designed to be remembered"},{"type":"textarea","id":"slide_1_text","label":"Slide 1 text","default":"Discover refined silhouettes made for your most confident moments."},{"type":"url","id":"slide_1_link","label":"Slide 1 link"},{"type":"image_picker","id":"slide_2_image","label":"Slide 2 image"},{"type":"text","id":"slide_2_heading","label":"Slide 2 heading","default":"Quiet luxury, your way"},{"type":"textarea","id":"slide_2_text","label":"Slide 2 text","default":"Elevated pieces with an effortless finish."},{"type":"url","id":"slide_2_link","label":"Slide 2 link"},{"type":"image_picker","id":"slide_3_image","label":"Slide 3 image"},{"type":"text","id":"slide_3_heading","label":"Slide 3 heading","default":"Your signature style"},{"type":"textarea","id":"slide_3_text","label":"Slide 3 text","default":"Find the details that make every look feel personal."},{"type":"url","id":"slide_3_link","label":"Slide 3 link"}],"presets":[{"name":"Blurred side slideshow"}],"tag":null,"class":"blurred-side-slideshow"}{% endschema %}