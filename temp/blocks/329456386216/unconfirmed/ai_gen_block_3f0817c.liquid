{% doc %}
  @prompt
    Create a custom "Buy it now" button that matches the exact design and styling of the "Add to Cart" button on the product page. The button should have the same background color, text color, font size, border radius, padding, and overall appearance as the "Add to Cart" button. The "Buy it now" button should trigger the accelerated checkout (dynamic checkout) functionality when clicked, just like the native Buy it now button, but visually styled to look identical to the Add to Cart button.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% capture ai_form_class %}ai-buy-now-{{ ai_gen_id }}__form{% endcapture %}
{% style %}.ai-buy-now-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%}.ai-buy-now-{{ ai_gen_id }}__form{width:100%}.ai-buy-now-{{ ai_gen_id }}__trigger{display:flex;align-items:center;justify-content:center;width:100%;min-height:48px;padding:14px 24px;border:{{ settings.primary_button_border_width }}px solid {{ settings.palette_primary_button_border }};border-radius:{{ settings.button_border_radius_primary }}px;background:{{ settings.palette_primary_button_background }};color:{{ settings.palette_primary_button_text }};font-family:{{ settings.type_accent_font.family }};font-size:14px;font-weight:400;line-height:1.2;letter-spacing:.04em;text-transform:uppercase;text-align:center;cursor:pointer;appearance:none;-webkit-appearance:none}.ai-buy-now-{{ ai_gen_id }}__trigger:hover{opacity:.85}.ai-buy-now-{{ ai_gen_id }}__trigger:focus-visible{outline:2px solid {{ settings.palette_primary_button_text }};outline-offset:3px}.ai-buy-now-{{ ai_gen_id }}__native{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap}@media screen and (max-width:749px){.ai-buy-now-{{ ai_gen_id }}{width:100%}}{% endstyle %}
<buy-now-button-{{ ai_gen_id }} class="ai-buy-now-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
{% form 'product', product, class: ai_form_class %}
<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
<button type="button" class="ai-buy-now-{{ ai_gen_id }}__trigger" aria-label="{{ block.settings.button_label | escape }}">{{ block.settings.button_label | escape }}</button>
<div class="ai-buy-now-{{ ai_gen_id }}__native" aria-hidden="true">{{ form | payment_button }}</div>
{% endform %}
</buy-now-button-{{ ai_gen_id }}>
<script>(function(){class BuyNowButton{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.trigger=this.querySelector('.ai-buy-now-{{ ai_gen_id }}__trigger');this.nativeButton=this.querySelector('.shopify-payment-button__button');if(!this.trigger||!this.nativeButton)return;this.trigger.addEventListener('click',()=>{this.nativeButton.click()})}}if(!customElements.get('buy-now-button-{{ ai_gen_id }}'))customElements.define('buy-now-button-{{ ai_gen_id }}',BuyNowButton{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Buy now button","settings":[{"type":"text","id":"button_label","label":"Button label","default":"Buy it now"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}],"presets":[{"name":"Buy now button"}],"tag":null,"class":"buy-now-button-block"}{% endschema %}