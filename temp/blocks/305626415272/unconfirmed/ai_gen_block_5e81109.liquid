{% doc %}
  @prompt
    related product 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-related-product-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
  }

  .ai-related-product-{{ ai_gen_id }}__inner {
    display: grid;
    grid-template-columns: minmax(120px, 180px) 1fr;
    gap: 24px;
    align-items: center;
    padding: 20px;
    background: {{ block.settings.background_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-related-product-{{ ai_gen_id }}__media,
  .ai-related-product-{{ ai_gen_id }}__placeholder {
    aspect-ratio: 1 / 1;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_radius }}px;
    background: {{ block.settings.placeholder_color }};
  }

  .ai-related-product-{{ ai_gen_id }}__media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .ai-related-product-{{ ai_gen_id }}__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-related-product-{{ ai_gen_id }}__placeholder svg {
    width: 70%;
    height: 70%;
    color: {{ block.settings.muted_color }};
  }

  .ai-related-product-{{ ai_gen_id }}__content {
    min-width: 0;
  }

  .ai-related-product-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 8px;
    color: {{ block.settings.muted_color }};
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ai-related-product-{{ ai_gen_id }}__title {
    margin: 0 0 10px;
    color: {{ block.settings.text_color }};
    font-size: 22px;
    line-height: 1.2;
  }

  .ai-related-product-{{ ai_gen_id }}__price {
    margin: 0 0 18px;
    color: {{ block.settings.text_color }};
    font-size: 16px;
  }

  .ai-related-product-{{ ai_gen_id }}__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 20px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: 1px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.button_radius }}px;
    font-size: 14px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .ai-related-product-{{ ai_gen_id }}__link:hover {
    opacity: 0.8;
  }

  .ai-related-product-{{ ai_gen_id }}__link:focus-visible {
    outline: 2px solid {{ block.settings.text_color }};
    outline-offset: 3px;
  }

  .ai-related-product-{{ ai_gen_id }}__empty {
    padding: 24px;
    border: 1px dashed {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    color: {{ block.settings.muted_color }};
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-related-product-{{ ai_gen_id }}__inner {
      grid-template-columns: 100px 1fr;
      gap: 16px;
      padding: 14px;
    }

    .ai-related-product-{{ ai_gen_id }}__title {
      font-size: 18px;
    }

    .ai-related-product-{{ ai_gen_id }}__price {
      margin-bottom: 12px;
    }

    .ai-related-product-{{ ai_gen_id }}__link {
      width: 100%;
      padding-inline: 12px;
    }
  }
{% endstyle %}

<div class="ai-related-product-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.related_product != blank %}
    {% assign related_product = block.settings.related_product %}
    <div class="ai-related-product-{{ ai_gen_id }}__inner">
      <a class="ai-related-product-{{ ai_gen_id }}__media" href="{{ related_product.url }}" aria-label="View {{ related_product.title | escape }}">
        {% if related_product.featured_image %}
          <img src="{{ related_product.featured_image | image_url: width: 500 }}" alt="{{ related_product.featured_image.alt | default: related_product.title | escape }}" loading="lazy" width="500" height="500">
        {% else %}
          <div class="ai-related-product-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
        {% endif %}
      </a>
      <div class="ai-related-product-{{ ai_gen_id }}__content">
        {% if block.settings.eyebrow != blank %}<p class="ai-related-product-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
        <h2 class="ai-related-product-{{ ai_gen_id }}__title">{{ related_product.title }}</h2>
        <p class="ai-related-product-{{ ai_gen_id }}__price">{{ related_product.price | money }}</p>
        <a class="ai-related-product-{{ ai_gen_id }}__link" href="{{ related_product.url }}">{{ block.settings.button_label }}</a>
      </div>
    </div>
  {% else %}
    <div class="ai-related-product-{{ ai_gen_id }}__empty" {{ block.shopify_attributes }}>Select a related product in the theme editor.</div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Related product",
  "settings": [
    {
      "type": "product",
      "id": "related_product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "You may also like"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View product"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7f2ec"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#6d263d"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#6a5046"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#e9dadb"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Placeholder",
      "default": "#e9dadb"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button",
      "default": "#6d263d"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#f7f2ec"
    },
    {
      "type": "header",
      "content": "Shape"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Card radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "Related product"
    }
  ],
  "tag": null,
  "class": "related-product-block"
}
{% endschema %}