{% doc %}
  @prompt
    عايز اعمل نفس السكشن بتاع عرض صور سكرين شوت لريفيوز العملاء
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-review-gallery-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    padding: 28px 16px;
    color: #6d263d;
    background: #f7f2ec;
  }

  .ai-review-gallery-{{ ai_gen_id }}__inner { max-width: 1200px; margin: 0 auto; }
  .ai-review-gallery-{{ ai_gen_id }}__heading { margin: 0 0 8px; color: #6d263d; font-size: {{ block.settings.heading_size }}px; line-height: 1.25; }
  .ai-review-gallery-{{ ai_gen_id }}__intro { margin: 0 0 22px; color: #2a2526; font-size: 14px; }
  .ai-review-gallery-{{ ai_gen_id }}__grid { display: grid; grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr)); gap: 14px; }
  .ai-review-gallery-{{ ai_gen_id }}__item { overflow: hidden; background: #fff; border: 1px solid #e9dadb; border-radius: 10px; }
  .ai-review-gallery-{{ ai_gen_id }}__image-wrap { display: block; aspect-ratio: 4 / 5; overflow: hidden; background: #e9dadb; }
  .ai-review-gallery-{{ ai_gen_id }}__image-wrap img, .ai-review-gallery-{{ ai_gen_id }}__image-wrap svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ai-review-gallery-{{ ai_gen_id }}__placeholder { position: relative; height: 100%; }
  .ai-review-gallery-{{ ai_gen_id }}__placeholder svg { color: #6d263d; }
  .ai-review-gallery-{{ ai_gen_id }}__empty { position: absolute; inset: auto 8px 8px; padding: 7px 9px; color: #2a2526; background: rgba(247,242,236,.94); text-align: center; font-size: 12px; }
  .ai-review-gallery-{{ ai_gen_id }}__caption { padding: 12px; color: #2a2526; font-size: 14px; line-height: 1.5; }
  .ai-review-gallery-{{ ai_gen_id }}__caption p { margin: 0; }

  @media screen and (max-width: 749px) {
    .ai-review-gallery-{{ ai_gen_id }} { padding: 22px 12px; }
    .ai-review-gallery-{{ ai_gen_id }}__grid { grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr)); gap: 10px; }
    .ai-review-gallery-{{ ai_gen_id }}__heading { font-size: {{ block.settings.heading_size | at_most: 32 }}px; }
    .ai-review-gallery-{{ ai_gen_id }}__caption { padding: 9px; font-size: 13px; }
  }
{% endstyle %}

<div class="ai-review-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-review-gallery-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}<h2 class="ai-review-gallery-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
    {% if block.settings.intro != blank %}<p class="ai-review-gallery-{{ ai_gen_id }}__intro">{{ block.settings.intro | escape }}</p>{% endif %}
    <div class="ai-review-gallery-{{ ai_gen_id }}__grid">
      {% for i in (1..6) %}
        {% assign image_key = 'review_image_' | append: i %}
        {% assign caption_key = 'review_caption_' | append: i %}
        {% assign review_image = block.settings[image_key] %}
        {% assign review_caption = block.settings[caption_key] %}
        {% if review_image != blank or review_caption != blank or forloop.index == 1 %}
          <article class="ai-review-gallery-{{ ai_gen_id }}__item">
            <div class="ai-review-gallery-{{ ai_gen_id }}__image-wrap">
              {% if review_image != blank %}
                <img src="{{ review_image | image_url: width: 900 }}" alt="{{ review_image.alt | default: block.settings.heading | escape }}" loading="lazy" width="{{ review_image.width }}" height="{{ review_image.height }}">
              {% else %}
                <div class="ai-review-gallery-{{ ai_gen_id }}__placeholder">
                  {{ 'image' | placeholder_svg_tag }}
                  <span class="ai-review-gallery-{{ ai_gen_id }}__empty">أضيفي صورة سكرين شوت للريفيو من إعدادات البلوك</span>
                </div>
              {% endif %}
            </div>
            {% if review_caption != blank %}<div class="ai-review-gallery-{{ ai_gen_id }}__caption">{{ review_caption | escape | newline_to_br }}</div>{% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer review images",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "آراء عميلاتنا" },
    { "type": "text", "id": "intro", "label": "Intro text", "default": "تجارب ومراجعات من عميلاتنا" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 18, "max": 48, "step": 2, "unit": "px", "default": 30 },
    { "type": "select", "id": "columns_desktop", "label": "Desktop columns", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "3" },
    { "type": "select", "id": "columns_mobile", "label": "Mobile columns", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "header", "content": "Review screenshots" },
    { "type": "image_picker", "id": "review_image_1", "label": "Screenshot 1" },
    { "type": "text", "id": "review_caption_1", "label": "Caption 1" },
    { "type": "image_picker", "id": "review_image_2", "label": "Screenshot 2" },
    { "type": "text", "id": "review_caption_2", "label": "Caption 2" },
    { "type": "image_picker", "id": "review_image_3", "label": "Screenshot 3" },
    { "type": "text", "id": "review_caption_3", "label": "Caption 3" },
    { "type": "image_picker", "id": "review_image_4", "label": "Screenshot 4" },
    { "type": "text", "id": "review_caption_4", "label": "Caption 4" },
    { "type": "image_picker", "id": "review_image_5", "label": "Screenshot 5" },
    { "type": "text", "id": "review_caption_5", "label": "Caption 5" },
    { "type": "image_picker", "id": "review_image_6", "label": "Screenshot 6" },
    { "type": "text", "id": "review_caption_6", "label": "Caption 6" }
  ],
  "presets": [{ "name": "Customer review images" }],
  "tag": null,
  "class": "customer-review-images"
}
{% endschema %}