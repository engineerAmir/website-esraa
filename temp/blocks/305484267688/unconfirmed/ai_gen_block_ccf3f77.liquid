{% doc %}
  @prompt
    create inputs for height and weght meta feild 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-measurements-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_body_font.family }}, sans-serif;
  }

  .ai-measurements-{{ ai_gen_id }}__title {
    margin: 0 0 6px;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_heading_font.family }}, sans-serif;
    font-size: 18px;
    line-height: 1.3;
  }

  .ai-measurements-{{ ai_gen_id }}__description {
    margin: 0 0 16px;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.5;
  }

  .ai-measurements-{{ ai_gen_id }}__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .ai-measurements-{{ ai_gen_id }}__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .ai-measurements-{{ ai_gen_id }}__label {
    color: {{ block.settings.text_color }};
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-measurements-{{ ai_gen_id }}__input {
    width: 100%;
    min-height: 46px;
    box-sizing: border-box;
    padding: 11px 12px;
    border: {{ settings.input_border_width }}px solid {{ settings.palette_input_border }};
    border-radius: {{ settings.inputs_border_radius }}px;
    background: {{ settings.palette_input_background }};
    color: {{ settings.palette_input_text }};
    font: inherit;
    font-size: 14px;
  }

  .ai-measurements-{{ ai_gen_id }}__input:focus {
    outline: 2px solid {{ settings.palette_input_border }};
    outline-offset: 2px;
  }

  @media screen and (max-width: 749px) {
    .ai-measurements-{{ ai_gen_id }} {
      width: 100%;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-measurements-{{ ai_gen_id }}__fields {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<product-measurements-{{ ai_gen_id }}
  class="ai-measurements-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.title != blank %}
    <h3 class="ai-measurements-{{ ai_gen_id }}__title">{{ block.settings.title | escape }}</h3>
  {% endif %}

  {% if block.settings.description != blank %}
    <p class="ai-measurements-{{ ai_gen_id }}__description">{{ block.settings.description | escape }}</p>
  {% endif %}

  <div class="ai-measurements-{{ ai_gen_id }}__fields">
    <div class="ai-measurements-{{ ai_gen_id }}__field">
      <label class="ai-measurements-{{ ai_gen_id }}__label" for="ai-height-{{ ai_gen_id }}">
        {{ block.settings.height_label | escape }}{% if block.settings.required_fields %} *{% endif %}
      </label>
      <input
        id="ai-height-{{ ai_gen_id }}"
        class="ai-measurements-{{ ai_gen_id }}__input"
        type="number"
        name="properties[{{ block.settings.height_property_name | escape }}]"
        min="1"
        max="300"
        step="0.1"
        placeholder="{{ block.settings.height_placeholder | escape }}"
        {% if block.settings.required_fields %}required{% endif %}
        aria-label="{{ block.settings.height_label | escape }}"
      >
    </div>

    <div class="ai-measurements-{{ ai_gen_id }}__field">
      <label class="ai-measurements-{{ ai_gen_id }}__label" for="ai-weight-{{ ai_gen_id }}">
        {{ block.settings.weight_label | escape }}{% if block.settings.required_fields %} *{% endif %}
      </label>
      <input
        id="ai-weight-{{ ai_gen_id }}"
        class="ai-measurements-{{ ai_gen_id }}__input"
        type="number"
        name="properties[{{ block.settings.weight_property_name | escape }}]"
        min="1"
        max="500"
        step="0.1"
        placeholder="{{ block.settings.weight_placeholder | escape }}"
        {% if block.settings.required_fields %}required{% endif %}
        aria-label="{{ block.settings.weight_label | escape }}"
      >
    </div>
  </div>
</product-measurements-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Height and weight inputs",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Your measurements"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Add your height and weight to help us prepare your order."
    },
    {
      "type": "text",
      "id": "height_label",
      "label": "Height label",
      "default": "Height (cm)"
    },
    {
      "type": "text",
      "id": "weight_label",
      "label": "Weight label",
      "default": "Weight (kg)"
    },
    {
      "type": "text",
      "id": "height_placeholder",
      "label": "Height placeholder",
      "default": "Example: 170"
    },
    {
      "type": "text",
      "id": "weight_placeholder",
      "label": "Weight placeholder",
      "default": "Example: 65"
    },
    {
      "type": "text",
      "id": "height_property_name",
      "label": "Height property name",
      "default": "Height"
    },
    {
      "type": "text",
      "id": "weight_property_name",
      "label": "Weight property name",
      "default": "Weight"
    },
    {
      "type": "checkbox",
      "id": "required_fields",
      "label": "Require both fields",
      "default": false
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#6d263d"
    }
  ],
  "presets": [
    {
      "name": "Height and weight inputs"
    }
  ],
  "tag": null,
  "class": "height-weight-inputs"
}
{% endschema %}