{% doc %}
  @prompt
    Create a premium responsive About Us section/page for “Esraa Fashion Designer”, an Egyptian modest womenswear brand with 5 years of experience. Esraa designs creative hijabi fashion: shirts, dresses, suits and statement outfits. A special service is custom matching mother-and-daughter outfits.
    
    Style: luxury editorial fashion, feminine, sophisticated, warm neutral palette, large portrait photography, serif headings, clean sans-serif text, generous whitespace, thin dividers, asymmetric layouts and subtle scroll/hover animations. Avoid generic cards, gradients and excessive rounded corners.
    
    Include:
    1. Hero: “Designed for Her. Inspired by Her Story.” + image + Shop Collection CTA.
    2. Meet Esraa: designer portrait + brand story.
    3. Our Story: “Five Years of Designing More Than Clothes.”
    4. Esraa Woman: modern, modest, confident Egyptian women.
    5. Large Mother & Daughter section with “Your style. Her little version. One beautiful memory.” + WhatsApp CTA.
    6. 4 values: Modest by Design, Creative Details, Made for Women, Designed in Egypt.
    7. 3-image editorial gallery.
    8. Stats: 5 Years / Designer Vision / ∞ Ways to Express You / 2 Generations.
    9. Full-width image statement: “Designed to Feel Like You.”
    10. Final Shop + WhatsApp CTA.
    
    Use Shopify Liquid. Make images, text, links, colors, overlay and spacing editable in Theme Editor with schema/image_picker. Support separate mobile images. Portrait images must not crop badly. Fully responsive. No external libraries.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-about-{{ ai_gen_id }}{display:block;width:100%;background:{{ block.settings.background }};color:{{ block.settings.text_color }};font-family:{{ block.settings.body_font.family }},sans-serif}.ai-about-{{ ai_gen_id }}__inner{width:{{ block.settings.desktop_width_percent }}%;max-width:1500px;margin:auto}.ai-about-{{ ai_gen_id }} h1,.ai-about-{{ ai_gen_id }} h2,.ai-about-{{ ai_gen_id }} h3{font-family:{{ block.settings.heading_font.family }},serif;font-weight:400;color:{{ block.settings.heading_color }};margin:0 0 24px}.ai-about-{{ ai_gen_id }} p{line-height:1.8;margin:0}.ai-about-{{ ai_gen_id }}__hero,.ai-about-{{ ai_gen_id }}__split,.ai-about-{{ ai_gen_id }}__mother,.ai-about-{{ ai_gen_id }}__woman{display:grid;grid-template-columns:1fr 1fr;gap:9%;align-items:center;padding:9% 6%}.ai-about-{{ ai_gen_id }}__hero{background:{{ block.settings.hero_background }};grid-template-columns:.8fr 1.2fr}.ai-about-{{ ai_gen_id }} h1{font-size:clamp(42px,6vw,88px);line-height:1.03}.ai-about-{{ ai_gen_id }} h2{font-size:clamp(36px,5vw,68px);line-height:1.08}.ai-about-{{ ai_gen_id }}__kicker{font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:{{ block.settings.accent_color }};margin-bottom:22px}.ai-about-{{ ai_gen_id }}__media{height:620px;overflow:hidden;background:{{ block.settings.placeholder_color }};position:relative}.ai-about-{{ ai_gen_id }}__media img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block}.ai-about-{{ ai_gen_id }}__media svg{width:100%;height:100%}.ai-about-{{ ai_gen_id }}__button{display:inline-block;margin-top:28px;padding:15px 24px;border:1px solid {{ block.settings.heading_color }};color:{{ block.settings.heading_color }};text-decoration:none;font-size:11px;letter-spacing:.12em;text-transform:uppercase}.ai-about-{{ ai_gen_id }}__button:hover{background:{{ block.settings.heading_color }};color:{{ block.settings.background }}}.ai-about-{{ ai_gen_id }}__statement,.ai-about-{{ ai_gen_id }}__final{text-align:center;padding:11% 8%;background:{{ block.settings.statement_background }}}.ai-about-{{ ai_gen_id }}__statement h2,.ai-about-{{ ai_gen_id }}__final h2{max-width:900px;margin:0 auto 25px}.ai-about-{{ ai_gen_id }}__values,.ai-about-{{ ai_gen_id }}__stats{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;padding:8% 6%;border-top:1px solid {{ block.settings.divider_color }};border-bottom:1px solid {{ block.settings.divider_color }}}.ai-about-{{ ai_gen_id }}__value,.ai-about-{{ ai_gen_id }}__stat{padding:20px 10px;border-right:1px solid {{ block.settings.divider_color }}}.ai-about-{{ ai_gen_id }}__value:last-child,.ai-about-{{ ai_gen_id }}__stat:last-child{border:0}.ai-about-{{ ai_gen_id }}__value small{color:{{ block.settings.accent_color }}}.ai-about-{{ ai_gen_id }}__gallery{display:grid;grid-template-columns:1fr 1.25fr 1fr;gap:18px;padding:9% 6%}.ai-about-{{ ai_gen_id }}__gallery .ai-about-{{ ai_gen_id }}__media{height:430px}.ai-about-{{ ai_gen_id }}__gallery div:nth-child(2) .ai-about-{{ ai_gen_id }}__media{height:540px;margin-top:80px}.ai-about-{{ ai_gen_id }}__stat{text-align:center}.ai-about-{{ ai_gen_id }}__stat strong{display:block;font:400 clamp(32px,4vw,58px) {{ block.settings.heading_font.family }},serif;color:{{ block.settings.heading_color }}}.ai-about-{{ ai_gen_id }}__stat span{font-size:11px;letter-spacing:.1em;text-transform:uppercase}.ai-about-{{ ai_gen_id }}__full{height:680px}.ai-about-{{ ai_gen_id }}__full .ai-about-{{ ai_gen_id }}__overlay{position:absolute;inset:0;background:{{ block.settings.overlay_color }};display:flex;align-items:center;justify-content:center;text-align:center}.ai-about-{{ ai_gen_id }}__overlay h2{color:{{ block.settings.overlay_text_color }};font-size:clamp(38px,6vw,80px)}.ai-about-{{ ai_gen_id }}__actions{display:flex;gap:15px;justify-content:center;flex-wrap:wrap}@media(max-width:749px){.ai-about-{{ ai_gen_id }}__inner{width:100%}.ai-about-{{ ai_gen_id }}__hero,.ai-about-{{ ai_gen_id }}__split,.ai-about-{{ ai_gen_id }}__mother,.ai-about-{{ ai_gen_id }}__woman{grid-template-columns:1fr;padding:16% 7%;gap:42px}.ai-about-{{ ai_gen_id }}__media{height:480px}.ai-about-{{ ai_gen_id }}__values,.ai-about-{{ ai_gen_id }}__stats{grid-template-columns:1fr 1fr;padding:14% 7%}.ai-about-{{ ai_gen_id }}__gallery{grid-template-columns:1fr;padding:16% 7%}.ai-about-{{ ai_gen_id }}__gallery div:nth-child(2) .ai-about-{{ ai_gen_id }}__media{margin-top:0}.ai-about-{{ ai_gen_id }}__full{height:500px}}
{% endstyle %}
<about-editorial-{{ ai_gen_id }} class="ai-about-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-about-{{ ai_gen_id }}__inner"><section class="ai-about-{{ ai_gen_id }}__hero"><div><div class="ai-about-{{ ai_gen_id }}__kicker">{{ block.settings.hero_kicker }}</div><h1>{{ block.settings.hero_title }}</h1><p>{{ block.settings.hero_text }}</p><a class="ai-about-{{ ai_gen_id }}__button" href="{{ block.settings.shop_link }}">{{ block.settings.shop_label }}</a></div><div class="ai-about-{{ ai_gen_id }}__media">{% if block.settings.hero_image %}<picture>{% if block.settings.hero_mobile_image %}<source media="(max-width:749px)" srcset="{{ block.settings.hero_mobile_image | image_url: width:900 }}">{% endif %}<img src="{{ block.settings.hero_image | image_url: width:1400 }}" alt="{{ block.settings.hero_image.alt | escape }}"> </picture>{% else %}{{ 'hero-apparel-1' | placeholder_svg_tag }}{% endif %}</div></section><section class="ai-about-{{ ai_gen_id }}__split"><div class="ai-about-{{ ai_gen_id }}__media">{% if block.settings.designer_image %}<img src="{{ block.settings.designer_image | image_url: width:1000 }}" alt="{{ block.settings.designer_image.alt | escape }}">{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}</div><div><div class="ai-about-{{ ai_gen_id }}__kicker">{{ block.settings.meet_kicker }}</div><h2>{{ block.settings.meet_title }}</h2><p>{{ block.settings.meet_text }}</p></div></section><section class="ai-about-{{ ai_gen_id }}__statement"><h2>{{ block.settings.story_title }}</h2><p>{{ block.settings.story_text }}</p></section><section class="ai-about-{{ ai_gen_id }}__woman"><div><div class="ai-about-{{ ai_gen_id }}__kicker">{{ block.settings.woman_kicker }}</div><h2>{{ block.settings.woman_title }}</h2><p>{{ block.settings.woman_text }}</p></div><div class="ai-about-{{ ai_gen_id }}__media">{% if block.settings.woman_image %}<img src="{{ block.settings.woman_image | image_url: width:1100 }}" alt="{{ block.settings.woman_image.alt | escape }}">{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}</div></section><section class="ai-about-{{ ai_gen_id }}__values">{% for i in (1..4) %}{% assign key='value_' | append:i %}<div class="ai-about-{{ ai_gen_id }}__value"><small>0{{ i }}</small><h3>{{ block.settings[key] }}</h3></div>{% endfor %}</section><section class="ai-about-{{ ai_gen_id }}__mother"><div class="ai-about-{{ ai_gen_id }}__media">{% if block.settings.mother_image %}<img src="{{ block.settings.mother_image | image_url: width:1400 }}" alt="{{ block.settings.mother_image.alt | escape }}">{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}</div><div><div class="ai-about-{{ ai_gen_id }}__kicker">{{ block.settings.mother_kicker }}</div><h2>{{ block.settings.mother_title }}</h2><p>{{ block.settings.mother_text }}</p><a class="ai-about-{{ ai_gen_id }}__button" href="{{ block.settings.whatsapp_link }}">{{ block.settings.whatsapp_label }}</a></div></section><section class="ai-about-{{ ai_gen_id }}__gallery">{% for i in (1..3) %}{% assign key='gallery_' | append:i | append:'_image' %}<div class="ai-about-{{ ai_gen_id }}__media">{% if block.settings[key] %}<img src="{{ block.settings[key] | image_url: width:900 }}" alt="{{ block.settings[key].alt | escape }}">{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}</div>{% endfor %}</section><section class="ai-about-{{ ai_gen_id }}__stats"><div class="ai-about-{{ ai_gen_id }}__stat"><strong>5</strong><span>{{ block.settings.stat_1 }}</span></div><div class="ai-about-{{ ai_gen_id }}__stat"><strong>01</strong><span>{{ block.settings.stat_2 }}</span></div><div class="ai-about-{{ ai_gen_id }}__stat"><strong>∞</strong><span>{{ block.settings.stat_3 }}</span></div><div class="ai-about-{{ ai_gen_id }}__stat"><strong>02</strong><span>{{ block.settings.stat_4 }}</span></div></section><section class="ai-about-{{ ai_gen_id }}__full"><div class="ai-about-{{ ai_gen_id }}__media">{% if block.settings.statement_image %}<img src="{{ block.settings.statement_image | image_url: width:1800 }}" alt="{{ block.settings.statement_image.alt | escape }}">{% else %}{{ 'hero-apparel-1' | placeholder_svg_tag }}{% endif %}<div class="ai-about-{{ ai_gen_id }}__overlay"><h2>{{ block.settings.statement_title }}</h2></div></div></section><section class="ai-about-{{ ai_gen_id }}__final"><h2>{{ block.settings.final_title }}</h2><div class="ai-about-{{ ai_gen_id }}__actions"><a class="ai-about-{{ ai_gen_id }}__button" href="{{ block.settings.shop_link }}">{{ block.settings.shop_label }}</a><a class="ai-about-{{ ai_gen_id }}__button" href="{{ block.settings.whatsapp_link }}">{{ block.settings.whatsapp_label }}</a></div></section></div></about-editorial-{{ ai_gen_id }}>
