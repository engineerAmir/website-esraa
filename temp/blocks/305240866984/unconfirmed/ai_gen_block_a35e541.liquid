{% doc %}
  @prompt
    animated announcements 
    full controls 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-announcement-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};border-radius:{{ block.settings.border_radius }}px;overflow:hidden}.ai-announcement-{{ ai_gen_id }}__viewport{position:relative;min-height:{{ block.settings.min_height }}px}.ai-announcement-{{ ai_gen_id }}__track{display:flex;width:100%;transition:transform {{ block.settings.transition_speed }}ms ease}.ai-announcement-{{ ai_gen_id }}__item{flex:0 0 100%;box-sizing:border-box;display:flex;align-items:center;justify-content:{{ block.settings.alignment }};padding:{{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;text-align:{{ block.settings.text_alignment }};font-family:{{ block.settings.font.family }};font-size:{{ block.settings.font_size }}px;font-weight:{{ block.settings.font_weight }};letter-spacing:{{ block.settings.letter_spacing }}px;line-height:1.35}.ai-announcement-{{ ai_gen_id }}__item a{color:inherit;text-underline-offset:3px}.ai-announcement-{{ ai_gen_id }}__close{position:absolute;top:50%;right:12px;transform:translateY(-50%);display:{{ block.settings.close_display }};align-items:center;justify-content:center;width:28px;height:28px;padding:0;border:0;background:transparent;color:inherit;cursor:pointer;font-size:22px}.ai-announcement-{{ ai_gen_id }}__controls{position:absolute;left:12px;bottom:5px;display:{{ block.settings.controls_display }};gap:5px}.ai-announcement-{{ ai_gen_id }}__control{width:6px;height:6px;padding:0;border:0;border-radius:50%;background:currentColor;opacity:.45;cursor:pointer}.ai-announcement-{{ ai_gen_id }}__control[aria-current="true"]{opacity:1}.ai-announcement-{{ ai_gen_id }}__close:focus-visible,.ai-announcement-{{ ai_gen_id }}__control:focus-visible,.ai-announcement-{{ ai_gen_id }}__item a:focus-visible{outline:2px solid currentColor;outline-offset:3px}@media screen and (max-width:749px){.ai-announcement-{{ ai_gen_id }}{width:100%;border-radius:0}.ai-announcement-{{ ai_gen_id }}__item{padding-left:42px;padding-right:42px;font-size:{{ block.settings.mobile_font_size }}px}}{% endstyle %}
<announcement-banner-{{ ai_gen_id }} class="ai-announcement-{{ ai_gen_id }}" {{ block.shopify_attributes }} data-autoplay="{{ block.settings.autoplay }}" data-interval="{{ block.settings.interval }}" data-direction="{{ block.settings.direction }}"><div class="ai-announcement-{{ ai_gen_id }}__viewport" role="region" aria-label="Announcements" aria-live="polite"><div class="ai-announcement-{{ ai_gen_id }}__track">{% for i in (1..3) %}{% if i == 1 %}{% assign message = block.settings.message_1 %}{% assign link = block.settings.link_1 %}{% elsif i == 2 %}{% assign message = block.settings.message_2 %}{% assign link = block.settings.link_2 %}{% else %}{% assign message = block.settings.message_3 %}{% assign link = block.settings.link_3 %}{% endif %}{% if message != blank %}<div class="ai-announcement-{{ ai_gen_id }}__item">{% if link != blank %}<a href="{{ link }}">{{ message }}</a>{% else %}{{ message }}{% endif %}</div>{% endif %}{% endfor %}</div><div class="ai-announcement-{{ ai_gen_id }}__controls" aria-label="Announcement navigation">{% assign dot_index = 0 %}{% for i in (1..3) %}{% if i == 1 %}{% assign message = block.settings.message_1 %}{% elsif i == 2 %}{% assign message = block.settings.message_2 %}{% else %}{% assign message = block.settings.message_3 %}{% endif %}{% if message != blank %}<button class="ai-announcement-{{ ai_gen_id }}__control" type="button" data-index="{{ dot_index }}" aria-label="Show announcement {{ dot_index | plus: 1 }}" aria-current="{% if dot_index == 0 %}true{% else %}false{% endif %}"></button>{% assign dot_index = dot_index | plus: 1 %}{% endif %}{% endfor %}</div><button class="ai-announcement-{{ ai_gen_id }}__close" type="button" aria-label="Dismiss announcements">×</button></div></announcement-banner-{{ ai_gen_id }}>
<script>(function(){class AnnouncementBanner{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.track=this.querySelector('.ai-announcement-{{ ai_gen_id }}__track');this.items=this.querySelectorAll('.ai-announcement-{{ ai_gen_id }}__item');this.controls=this.querySelectorAll('.ai-announcement-{{ ai_gen_id }}__control');this.index=0;this.timer=null;this.controls.forEach(c=>c.addEventListener('click',()=>{this.show(Number(c.dataset.index));this.restart()}));this.querySelector('.ai-announcement-{{ ai_gen_id }}__close').addEventListener('click',()=>{this.hidden=true;this.stop()});this.addEventListener('mouseenter',()=>this.stop());this.addEventListener('mouseleave',()=>this.start());this.start()}show(i){if(!this.items.length)return;this.index=(i+this.items.length)%this.items.length;this.track.style.transform='translateX(-'+this.index*100+'%)';this.controls.forEach((c,n)=>c.setAttribute('aria-current',n===this.index?'true':'false'))}start(){if(this.dataset.autoplay!=='true'||this.items.length<2)return;this.stop();this.timer=setInterval(()=>this.show(this.index+(this.dataset.direction==='backward'?-1:1)),Number(this.dataset.interval))}stop(){if(this.timer)clearInterval(this.timer);this.timer=null}restart(){this.stop();this.start()}}if(!customElements.get('announcement-banner-{{ ai_gen_id }}'))customElements.define('announcement-banner-{{ ai_gen_id }}',AnnouncementBanner{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Animated announcements","tag":null,"class":"animated-announcements-block","settings":[{"type":"header","content":"Messages"},{"type":"text","id":"message_1","label":"Message 1","default":"New season styles have arrived"},{"type":"url","id":"link_1","label":"Link 1"},{"type":"text","id":"message_2","label":"Message 2","default":"Complimentary delivery on orders over 1500 EGP"},{"type":"url","id":"link_2","label":"Link 2"},{"type":"text","id":"message_3","label":"Message 3","default":"Discover pieces designed for your wardrobe"},{"type":"url","id":"link_3","label":"Link 3"},{"type":"header","content":"Animation"},{"type":"checkbox","id":"autoplay","label":"Autoplay","default":true},{"type":"range","id":"interval","label":"Display time","min":2000,"max":9500,"step":500,"unit":"ms","default":5000},{"type":"select","id":"direction","label":"Direction","options":[{"value":"forward","label":"Forward"},{"value":"backward","label":"Backward"}],"default":"forward"},{"type":"range","id":"transition_speed","label":"Transition speed","min":100,"max":1000,"step":100,"unit":"ms","default":400},{"type":"header","content":"Style"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"color","id":"background_color","label":"Background","default":"#6d263d"},{"type":"color","id":"text_color","label":"Text","default":"#ffffff"},{"type":"font_picker","id":"font","label":"Font","default":"comfortaa_n4"},{"type":"range","id":"font_size","label":"Text size","min":10,"max":24,"step":1,"unit":"px","default":14},{"type":"range","id":"mobile_font_size","label":"Mobile text size","min":10,"max":20,"step":1,"unit":"px","default":13},{"type":"range","id":"font_weight","label":"Text weight","min":400,"max":700,"step":100,"default":400},{"type":"range","id":"letter_spacing","label":"Letter spacing","min":0,"max":2,"step":0.5,"unit":"px","default":0},{"type":"range","id":"vertical_padding","label":"Vertical padding","min":4,"max":32,"step":2,"unit":"px","default":12},{"type":"range","id":"horizontal_padding","label":"Horizontal padding","min":12,"max":80,"step":4,"unit":"px","default":24},{"type":"range","id":"min_height","label":"Minimum height","min":30,"max":100,"step":5,"unit":"px","default":50},{"type":"range","id":"border_radius","label":"Corner radius","min":0,"max":24,"step":2,"unit":"px","default":0},{"type":"select","id":"alignment","label":"Alignment","options":[{"value":"flex-start","label":"Left"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Right"}],"default":"center"},{"type":"radio","id":"text_alignment","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"center"},{"type":"select","id":"controls_display","label":"Navigation dots","options":[{"value":"flex","label":"Show"},{"value":"none","label":"Hide"}],"default":"flex"},{"type":"select","id":"close_display","label":"Close button","options":[{"value":"flex","label":"Show"},{"value":"none","label":"Hide"}],"default":"none"}],"presets":[{"name":"Animated announcements"}]}
{% endschema %}