{% doc %}
  @prompt
    row of 4 circle for for collection 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-circles-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
  }

  .ai-collection-circles-{{ ai_gen_id }}__heading {
    margin: 0 0 24px;
    text-align: {{ block.settings.heading_alignment }};
    font-family: {{ block.settings.heading_font.family }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  .ai-collection-circles-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
    align-items: start;
  }

  .ai-collection-circles-{{ ai_gen_id }}__item {
    min-width: 0;
    text-align: center;
  }

  .ai-collection-circles-{{ ai_gen_id }}__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .ai-collection-circles-{{ ai_gen_id }}__image,
  .ai-collection-circles-{{ ai_gen_id }}__placeholder {
    display: block;
    width: {{ block.settings_circle_size }}px;
    height: {{ block.settings.circle_size }}px;
    max-width: 100%;
    margin: 0 auto 12px;
    overflow: hidden;
    border-radius: 50%;
    background: {{ block.settings.placeholder_color }};
  }

  .ai-collection-circles-{{ ai_gen_id }}__image {
    object-fit: cover;
    transition: opacity 0.2s ease;
  }

  .ai-collection-circles-{{ ai_gen_id }}__link:hover .ai-collection-circles-{{ ai_gen_id }}__image {
    opacity: 0.82;
  }

  .ai-collection-circles-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    color: {{ block.settings.placeholder_icon_color }};
  }

  .ai-collection-circles-{{ ai_gen_id }}__title {
    display: block;
    font-family: {{ block.settings.title_font.family }};
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-circles-{{ ai_gen_id }}__grid {
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-collection-circles-{{ ai_gen_id }}__image,
    .ai-collection-circles-{{ ai_gen_id }}__placeholder {
      width: {{ block.settings.mobile_circle_size }}px;
      height: {{ block.settings.mobile_circle_size }}px;
    }
  }
{% endstyle %}

<div class="ai-collection-circles-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-collection-circles-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}

  <div class="ai-collection-circles-{{ ai_gen_id }}__grid">
    {% for i in (1..4) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign collection = block.settings[collection_key]
      %}
      {% if collection != blank %}
        <div class="ai-collection-circles-{{ ai_gen_id }}__item">
          <a class="ai-collection-circles-{{ ai_gen_id }}__link" href="{{ collection.url }}" aria-label="View {{ collection.title | escape }}">
            {% if collection.featured_image %}
              <img
                class="ai-collection-circles-{{ ai_gen_id }}__image"
                src="{{ collection.featured_image | image_url: width: 500 }}"
                alt="{{ collection.featured_image.alt | default: collection.title | escape }}"
                loading="lazy"
                width="{{ block.settings.circle_size }}"
                height="{{ block.settings.circle_size }}"
              >
            {% else %}
              <div class="ai-collection-circles-{{ ai_gen_id }}__placeholder">
                {{ 'collection-apparel-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
            {% if block.settings.show_titles %}
              <span class="ai-collection-circles-{{ ai_gen_id }}__title">{{ collection.title | escape }}</span>
            {% endif %}
          </a>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Collection circles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop collections"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Collection 1"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Collection 2"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Collection 3"
    },
    {
      "type": "collection",
      "id": "collection_4",
      "label": "Collection 4"
    },
    {
      "type": "checkbox",
      "id": "show_titles",
      "label": "Show titles",
      "default": true
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "circle_size",
      "label": "Circle size",
      "min": 80,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "mobile_circle_size",
      "label": "Mobile circle size",
      "min": 50,
      "max": 180,
      "step": 10,
      "unit": "px",
      "default": 110
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between",
      "min": 4,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile spacing",
      "min": 4,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "shippori_antique_n4"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Title font",
      "default": "comfortaa_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 14,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#6d263d"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Placeholder",
      "default": "#e9dadb"
    },
    {
      "type": "color",
      "id": "placeholder_icon_color",
      "label": "Placeholder icon",
      "default": "#6d263d"
    }
  ],
  "presets": [
    {
      "name": "Collection circles"
    }
  ],
  "tag": null,
  "class": "collection-circles-block"
}
{% endschema %}