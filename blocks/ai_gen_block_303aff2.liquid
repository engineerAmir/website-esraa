{% doc %}
  @prompt
    shob by cate 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-shop-by-category-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_spacing }}px 0;
    color: {{ block.settings.text_color }};
  }

  .ai-shop-by-category-{{ ai_gen_id }}__heading {
    margin: 0 0 28px;
    text-align: {{ block.settings.alignment }};
    font-family: {{ settings.type_heading_font.family }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
    color: {{ block.settings.text_color }};
  }

  .ai-shop-by-category-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-shop-by-category-{{ ai_gen_id }}__card {
    display: block;
    color: {{ block.settings.text_color }};
    text-decoration: none;
  }

  .ai-shop-by-category-{{ ai_gen_id }}__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_radius }}px;
  }

  .ai-shop-by-category-{{ ai_gen_id }}__media img,
  .ai-shop-by-category-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-shop-by-category-{{ ai_gen_id }}__media svg {
    color: {{ block.settings.text_color }};
    opacity: 0.3;
  }

  .ai-shop-by-category-{{ ai_gen_id }}__card:hover .ai-shop-by-category-{{ ai_gen_id }}__media img {
    opacity: 0.86;
  }

  .ai-shop-by-category-{{ ai_gen_id }}__title {
    margin: 14px 0 0;
    font-family: {{ settings.type_body_font.family }};
    font-size: 16px;
    line-height: 1.3;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-shop-by-category-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_spacing }}px 0;
    }

    .ai-shop-by-category-{{ ai_gen_id }}__heading {
      margin-bottom: 20px;
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-shop-by-category-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: {{ block.settings.mobile_gap }}px;
    }
  }
{% endstyle %}

<shop-by-category-{{ ai_gen_id }} class="ai-shop-by-category-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-shop-by-category-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}

  {% if block.settings.collections != blank %}
    <div class="ai-shop-by-category-{{ ai_gen_id }}__grid">
      {% for collection in block.settings.collections %}
        <a class="ai-shop-by-category-{{ ai_gen_id }}__card" href="{{ collection.url }}" aria-label="Shop {{ collection.title | escape }}">
          <div class="ai-shop-by-category-{{ ai_gen_id }}__media">
            {% if collection.image %}
              <img src="{{ collection.image | image_url: width: 900 }}" alt="{{ collection.image.alt | default: collection.title | escape }}" loading="lazy" width="900" height="900">
            {% else %}
              {{ 'collection-apparel-1' | placeholder_svg_tag }}
            {% endif %}
          </div>
          <h3 class="ai-shop-by-category-{{ ai_gen_id }}__title">{{ collection.title | escape }}</h3>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-shop-by-category-{{ ai_gen_id }}__grid">
      {% for i in (1..4) %}
        <div class="ai-shop-by-category-{{ ai_gen_id }}__card">
          <div class="ai-shop-by-category-{{ ai_gen_id }}__media">{{ 'collection-apparel-1' | placeholder_svg_tag }}</div>
          <h3 class="ai-shop-by-category-{{ ai_gen_id }}__title">Add a collection</h3>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</shop-by-category-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Shop by category",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "collection_list", "id": "collections", "label": "Categories", "limit": 8 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "alignment", "label": "Heading alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "center" },
    { "type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 60, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 18, "max": 40, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "card_gap", "label": "Card gap", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "mobile_gap", "label": "Mobile card gap", "min": 8, "max": 28, "step": 4, "unit": "px", "default": 12 },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "section_spacing", "label": "Section spacing", "min": 0, "max": 80, "step": 8, "unit": "px", "default": 40 },
    { "type": "range", "id": "mobile_spacing", "label": "Mobile spacing", "min": 0, "max": 48, "step": 8, "unit": "px", "default": 24 },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#6d263d" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#e9dadb" }
  ],
  "presets": [{ "name": "Shop by category" }],
  "tag": null,
  "class": "shop-by-category-block"
}
{% endschema %}