{% doc %}
  @prompt
    3 centered collection circles
    exactly 3 collections
    fill width
    responsive desktop and mobile
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}

/* =========================
   MAIN WRAPPER
========================= */

.ai-collection-circles-{{ ai_gen_id }} {
  display: block;
  width: {{ block.settings.desktop_width_percent }}%;
  max-width: 100%;
  margin: 0 auto;
  color: {{ block.settings.text_color }};
}


/* =========================
   GRID - EXACTLY 3
========================= */

.ai-collection-circles__grid-{{ ai_gen_id }} {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: {{ block.settings.gap }}px;

  width: 100%;
  margin: 0 auto;

  justify-content: center;
  align-items: start;
}


/* Hide anything after 3 */
.ai-collection-circles__grid-{{ ai_gen_id }} > *:nth-child(n+4) {
  display: none !important;
}


/* =========================
   ITEM
========================= */

.ai-collection-circles__item-{{ ai_gen_id }} {
  width: 100%;
  min-width: 0;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;

  text-align: center;
}


/* =========================
   LINK
========================= */

.ai-collection-circles__link-{{ ai_gen_id }} {
  display: flex;
  flex-direction: column;

  width: 100%;

  align-items: center;
  justify-content: center;

  color: inherit;
  text-decoration: none;
}


/* =========================
   CIRCLE
========================= */

.ai-collection-circles__media-{{ ai_gen_id }} {
  position: relative;

  width: 100%;
  aspect-ratio: 1 / 1;

  margin: 0 auto;

  overflow: hidden;

  border-radius: 50%;

  background: {{ block.settings.placeholder_color }};

  border:
    {{ block.settings.border_width }}px
    solid
    {{ block.settings.border_color }};
}


/* =========================
   IMAGE
========================= */

.ai-collection-circles__media-{{ ai_gen_id }} img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
  object-position: center;

  border-radius: 50%;
}


/* =========================
   PLACEHOLDER
========================= */

.ai-collection-circles__placeholder-{{ ai_gen_id }} {
  display: flex;

  align-items: center;
  justify-content: center;

  width: 100%;
  height: 100%;

  color: {{ block.settings.text_color }};
}


.ai-collection-circles__placeholder-{{ ai_gen_id }} svg {
  width: 52%;
  height: 52%;

  opacity: 0.35;
}


/* =========================
   TITLE
========================= */

.ai-collection-circles__title-{{ ai_gen_id }} {
  width: 100%;

  margin:
    {{ block.settings.title_spacing }}px
    0
    0;

  padding: 0;

  text-align: center;

  font-family: {{ block.settings.heading_font.family }};
  font-size: {{ block.settings.title_size }}px;
  font-weight: 500;

  line-height: 1.25;

  text-wrap: balance;
}


/* =========================
   MOBILE
========================= */

@media screen and (max-width: 749px) {

  .ai-collection-circles-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;

    margin-left: auto;
    margin-right: auto;

    padding: 0;
  }


  .ai-collection-circles__grid-{{ ai_gen_id }} {

    display: grid;

    /* ALWAYS 3 */
    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: {{ block.settings.mobile_gap }}px;

    width: 100%;

    margin-left: auto;
    margin-right: auto;

    justify-content: center;
    align-items: start;
  }


  .ai-collection-circles__item-{{ ai_gen_id }} {
    width: 100%;

    display: flex;

    flex-direction: column;

    align-items: center;
    justify-content: flex-start;

    text-align: center;
  }


  .ai-collection-circles__link-{{ ai_gen_id }} {
    width: 100%;

    display: flex;

    flex-direction: column;

    align-items: center;
    justify-content: center;
  }


  .ai-collection-circles__media-{{ ai_gen_id }} {

    width: 100%;

    aspect-ratio: 1 / 1;

    margin-left: auto;
    margin-right: auto;

    border-radius: 50%;
  }


  .ai-collection-circles__title-{{ ai_gen_id }} {

    width: 100%;

    font-size:
      {{ block.settings.mobile_title_size }}px;

    text-align: center;

    margin-top:
      {{ block.settings.title_spacing }}px;
  }

}

{% endstyle %}


<!-- =========================
     COLLECTIONS
========================= -->

<div
  class="ai-collection-circles-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>

  <div class="ai-collection-circles__grid-{{ ai_gen_id }}">

    {% for i in (1..3) %}

    

      <div
        class="ai-collection-circles__item-{{ ai_gen_id }}"
      >

        {% if collection != blank %}

          <a
            class="ai-collection-circles__link-{{ ai_gen_id }}"
            href="{{ collection.url }}"
            aria-label="View {{ collection.title | escape }} collection"
          >


            <div
              class="ai-collection-circles__media-{{ ai_gen_id }}"
            >

              {% if collection.featured_image %}

                <img
                  src="{{ collection.featured_image | image_url: width: 1000 }}"
                  alt="{{ collection.featured_image.alt | default: collection.title | escape }}"
                  loading="lazy"
                  width="1000"
                  height="1000"
                >

              {% else %}

                <div
                  class="ai-collection-circles__placeholder-{{ ai_gen_id }}"
                >

                  {{
                    'collection-apparel-1'
                    | placeholder_svg_tag
                  }}

                </div>

              {% endif %}

            </div>


            


          </a>


        {% else %}


          <div
            class="ai-collection-circles__media-{{ ai_gen_id }}"
          >

            <div
              class="ai-collection-circles__placeholder-{{ ai_gen_id }}"
            >

              {{
                'collection-apparel-1'
                | placeholder_svg_tag
              }}

            </div>

          </div>


        {% endif %}

      </div>


    {% endfor %}

  </div>

</div>


