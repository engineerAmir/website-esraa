{% doc %}
  @prompt
    عايز اعمل نفس السكشن بتاع عرض صور سكرين شوت لريفيوز العملاء, انا عايز اعرضهم بشكل كاروسيل وهعرض 15 صورة
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-review-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    padding: 28px 16px;
    color: #6d263d;
    background: #f7f2ec;
  }
  .ai-review-carousel-{{ ai_gen_id }}__inner { max-width: 1200px; margin: 0 auto; }
  .ai-review-carousel-{{ ai_gen_id }}__heading { margin: 0 0 8px; color: #6d263d; font-size: {{ block.settings.heading_size }}px; line-height: 1.25; }
  .ai-review-carousel-{{ ai_gen_id }}__intro { margin: 0 0 20px; color: #2a2526; font-size: 14px; }
  .ai-review-carousel-{{ ai_gen_id }}__toolbar { display: flex; justify-content: flex-end; gap: 8px; margin-bottom: 10px; }
  .ai-review-carousel-{{ ai_gen_id }}__button { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; padding: 0; border: 1px solid #6d263d; border-radius: 50%; background: #f7f2ec; color: #6d263d; cursor: pointer; }
  .ai-review-carousel-{{ ai_gen_id }}__button:hover { background: #6d263d; color: #fff; }
  .ai-review-carousel-{{ ai_gen_id }}__button:focus-visible { outline: 3px solid #2a2526; outline-offset: 3px; }
  .ai-review-carousel-{{ ai_gen_id }}__button svg { width: 18px; height: 18px; }
  .ai-review-carousel-{{ ai_gen_id }}__track { display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; padding: 2px 1px 12px; scrollbar-color: #6d263d #e9dadb; scrollbar-width: thin; }
  .ai-review-carousel-{{ ai_gen_id }}__item { flex: 0 0 calc((100% - 28px) / 3); min-width: 0; overflow: hidden; background: #fff; border: 1px solid #e9dadb; border-radius: 10px; scroll-snap-align: start; }
  .ai-review-carousel-{{ ai_gen_id }}__image-wrap { display: block; aspect-ratio: 4 / 5; overflow: hidden; background: #e9dadb; }
  .ai-review-carousel-{{ ai_gen_id }}__image-wrap img, .ai-review-carousel-{{ ai_gen_id }}__image-wrap svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ai-review-carousel-{{ ai_gen_id }}__placeholder { position: relative; height: 100%; }
  .ai-review-carousel-{{ ai_gen_id }}__placeholder svg { color: #6d263d; }
  .ai-review-carousel-{{ ai_gen_id }}__empty { position: absolute; inset: auto 8px 8px; padding: 7px 9px; color: #2a2526; background: rgba(247,242,236,.96); text-align: center; font-size: 12px; }
  .ai-review-carousel-{{ ai_gen_id }}__caption { padding: 12px; color: #2a2526; font-size: 14px; line-height: 1.5; }
  @media screen and (max-width: 749px) {
    .ai-review-carousel-{{ ai_gen_id }} { padding: 22px 12px; }
    .ai-review-carousel-{{ ai_gen_id }}__heading { font-size: {{ block.settings.heading_size | at_most: 32 }}px; }
    .ai-review-carousel-{{ ai_gen_id }}__item { flex-basis: calc((100% - 10px) / 1.5); }
    .ai-review-carousel-{{ ai_gen_id }}__track { gap: 10px; }
    .ai-review-carousel-{{ ai_gen_id }}__caption { padding: 9px; font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ai-review-carousel-{{ ai_gen_id }}__track { scroll-behavior: auto; }
  }
{% endstyle %}

<review-carousel-{{ ai_gen_id }} class="ai-review-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-review-carousel-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}<h2 class="ai-review-carousel-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
    {% if block.settings.intro != blank %}<p class="ai-review-carousel-{{ ai_gen_id }}__intro">{{ block.settings.intro | escape }}</p>{% endif %}
    <div class="ai-review-carousel-{{ ai_gen_id }}__toolbar">
      <button class="ai-review-carousel-{{ ai_gen_id }}__button" type="button" data-direction="previous" aria-label="الصورة السابقة">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m15 18-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="ai-review-carousel-{{ ai_gen_id }}__button" type="button" data-direction="next" aria-label="الصورة التالية">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 18 6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
    <div class="ai-review-carousel-{{ ai_gen_id }}__track" data-track tabindex="0" aria-label="صور مراجعات العميلات">
      {% for i in (1..15) %}
        {% assign image_key = 'review_image_' | append: i %}
        {% assign caption_key = 'review_caption_' | append: i %}
        {% assign review_image = block.settings[image_key] %}
        {% assign review_caption = block.settings[caption_key] %}
        {% if review_image != blank or review_caption != blank or forloop.index == 1 %}
          <article class="ai-review-carousel-{{ ai_gen_id }}__item">
            <div class="ai-review-carousel-{{ ai_gen_id }}__image-wrap">
              {% if review_image != blank %}
                <img src="{{ review_image | image_url: width: 900 }}" alt="{{ review_image.alt | default: block.settings.heading | escape }}" loading="lazy" width="{{ review_image.width }}" height="{{ review_image.height }}">
              {% else %}
                <div class="ai-review-carousel-{{ ai_gen_id }}__placeholder">
                  {{ 'image' | placeholder_svg_tag }}
                  <span class="ai-review-carousel-{{ ai_gen_id }}__empty">أضيفي صورة سكرين شوت للريفيو من إعدادات البلوك</span>
                </div>
              {% endif %}
            </div>
            {% if review_caption != blank %}<div class="ai-review-carousel-{{ ai_gen_id }}__caption">{{ review_caption | escape }}</div>{% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</review-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    const tagName = 'review-carousel-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class ReviewCarousel extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.buttons = this.querySelectorAll('.ai-review-carousel-{{ ai_gen_id }}__button');
        this.buttons.forEach((button) => {
          button.addEventListener('click', () => {
            const firstItem = this.track.querySelector('.ai-review-carousel-{{ ai_gen_id }}__item');
            if (!firstItem) return;
            const distance = firstItem.getBoundingClientRect().width + parseFloat(getComputedStyle(this.track).gap || 0);
            this.track.scrollBy({ left: button.dataset.direction === 'next' ? distance : -distance, behavior: 'smooth' });
          });
        });
      }
    }
    customElements.define(tagName, ReviewCarousel);
  })();
</script>

