{% if block.settings.enabled %}
  <div class="pdp-benefits pdp-benefits--three" {{ block.shopify_attributes }}>
    {% render 'product-editorial-items',
      item_settings: block.settings,
      class: 'pdp-items--benefits'
    %}
  </div>
{% endif %}

<style>
  /* Full width container */
  .pdp-benefits--three {
    width: 100%;
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
  }

  /* 3 equal columns */
  .pdp-benefits--three .pdp-items--benefits {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 auto !important;
    justify-content: center !important;
    align-items: stretch;
  }

  /* Each benefit centered */
  .pdp-benefits--three .pdp-items--benefits > * {
    width: 100% !important;
    min-width: 0;
    text-align: center !important;
    justify-content: center;
    align-items: center;
  }

  /* Hide item 4 completely */
  .pdp-benefits--three .pdp-items--benefits > *:nth-child(n+4) {
    display: none !important;
  }

  /* Center content inside each item */
  .pdp-benefits--three .pdp-items--benefits > * > * {
    margin-left: auto;
    margin-right: auto;
  }

  /* Mobile: still keep 3 items in one row */
  @media screen and (max-width: 749px) {
    .pdp-benefits--three .pdp-items--benefits {
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
      width: 100% !important;
    }

    .pdp-benefits--three .pdp-items--benefits > * {
      text-align: center !important;
    }
  }
</style>

