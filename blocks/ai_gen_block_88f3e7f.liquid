{% doc %}
  @prompt
    عايز  اعرض صور لعرض سكرين شوت ريفيوز للعملاء بشكل كاروسيل بعدد 15 صورة
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-review-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: #6d263d;
    padding: 24px 0;
  }

  .ai-review-carousel-{{ ai_gen_id }}__heading {
    margin: 0 0 18px;
    color: #6d263d;
    font-size: 24px;
    line-height: 1.3;
    text-align: {{ block.settings.heading_alignment }};
  }

  .ai-review-carousel-{{ ai_gen_id }}__track {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: #6d263d #e9dadb;
    padding: 0 2px 12px;
    direction: rtl;
  }

  .ai-review-carousel-{{ ai_gen_id }}__card {
    flex: 0 0 min(78%, 300px);
    scroll-snap-align: start;
    overflow: hidden;
    border: 1px solid #e9dadb;
    border-radius: {{ block.settings.corner_radius }}px;
    background: #f7f2ec;
  }

  .ai-review-carousel-{{ ai_gen_id }}__image-link,
  .ai-review-carousel-{{ ai_gen_id }}__image-wrap {
    display: block;
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #e9dadb;
  }

  .ai-review-carousel-{{ ai_gen_id }}__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-review-carousel-{{ ai_gen_id }}__placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    color: #6d263d;
    text-align: center;
  }

  .ai-review-carousel-{{ ai_gen_id }}__placeholder svg {
    width: 64%;
    height: 64%;
    max-height: 240px;
    color: #6d263d;
  }

  .ai-review-carousel-{{ ai_gen_id }}__empty-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
  }

  .ai-review-carousel-{{ ai_gen_id }}__caption {
    margin: 0;
    padding: 12px 14px;
    color: #6d263d;
    font-size: 14px;
    line-height: 1.5;
    text-align: right;
  }

  .ai-review-carousel-{{ ai_gen_id }}__controls {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 14px;
  }

  .ai-review-carousel-{{ ai_gen_id }}__button {
    display: inline-flex;
    width: 42px;
    height: 42px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid #6d263d;
    border-radius: 50%;
    background: #f7f2ec;
    color: #6d263d;
    cursor: pointer;
  }

  .ai-review-carousel-{{ ai_gen_id }}__button:hover {
    background: #6d263d;
    color: #ffffff;
  }

  .ai-review-carousel-{{ ai_gen_id }}__button:focus-visible,
  .ai-review-carousel-{{ ai_gen_id }}__image-link:focus-visible {
    outline: 3px solid #2a2526;
    outline-offset: 3px;
  }

  .ai-review-carousel-{{ ai_gen_id }}__button svg {
    width: 20px;
    height: 20px;
  }

  @media screen and (min-width: 750px) {
    .ai-review-carousel-{{ ai_gen_id }}__card {
      flex-basis: min(32%, 280px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-review-carousel-{{ ai_gen_id }}__track {
      scroll-behavior: auto !important;
    }
  }
{% endstyle %}

<review-carousel-{{ ai_gen_id }} class="ai-review-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-review-carousel-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}
  <div class="ai-review-carousel-{{ ai_gen_id }}__track" id="ai-review-track-{{ ai_gen_id }}" role="list" aria-label="آراء العملاء المصورة">
    {% for i in (1..15) %}
      {% liquid
        assign image_key = 'review_image_' | append: i
        assign caption_key = 'review_caption_' | append: i
        assign review_image = block.settings[image_key]
        assign review_caption = block.settings[caption_key]
      %}
      {% if review_image != blank %}
        <article class="ai-review-carousel-{{ ai_gen_id }}__card" role="listitem">
          {% if block.settings.enable_image_link %}
            <a class="ai-review-carousel-{{ ai_gen_id }}__image-link" href="{{ review_image | image_url: width: 1800 }}" target="_blank" rel="noopener" aria-label="فتح صورة مراجعة العميل رقم {{ i }} في تبويب جديد">
              <img class="ai-review-carousel-{{ ai_gen_id }}__image" src="{{ review_image | image_url: width: 700 }}" alt="{{ review_image.alt | default: 'لقطة شاشة لمراجعة عميل' | escape }}" loading="lazy" width="{{ review_image.width }}" height="{{ review_image.height }}">
            </a>
          {% else %}
            <div class="ai-review-carousel-{{ ai_gen_id }}__image-wrap">
              <img class="ai-review-carousel-{{ ai_gen_id }}__image" src="{{ review_image | image_url: width: 700 }}" alt="{{ review_image.alt | default: 'لقطة شاشة لمراجعة عميل' | escape }}" loading="lazy" width="{{ review_image.width }}" height="{{ review_image.height }}">
            </div>
          {% endif %}
          {% if review_caption != blank %}<p class="ai-review-carousel-{{ ai_gen_id }}__caption">{{ review_caption | escape }}</p>{% endif %}
        </article>
      {% elsif request.design_mode %}
        <article class="ai-review-carousel-{{ ai_gen_id }}__card" role="listitem">
          <div class="ai-review-carousel-{{ ai_gen_id }}__image-wrap">
            <div class="ai-review-carousel-{{ ai_gen_id }}__placeholder">
              {{ 'image' | placeholder_svg_tag }}
              <p class="ai-review-carousel-{{ ai_gen_id }}__empty-text">أضيفي صورة لقطة شاشة المراجعة رقم {{ i }} من إعدادات هذا البلوك.</p>
            </div>
          </div>
        </article>
      {% endif %}
    {% endfor %}
  </div>
  <div class="ai-review-carousel-{{ ai_gen_id }}__controls" aria-label="التنقل بين صور المراجعات">
    <button class="ai-review-carousel-{{ ai_gen_id }}__button" type="button" data-direction="previous" aria-label="الصورة السابقة">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <button class="ai-review-carousel-{{ ai_gen_id }}__button" type="button" data-direction="next" aria-label="الصورة التالية">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
    </button>
  </div>
</review-carousel-{{ ai_gen_id }}>

<script>
  (() => {
    const tagName = 'review-carousel-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class ReviewCarousel extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('#ai-review-track-{{ ai_gen_id }}');
        this.querySelectorAll('.ai-review-carousel-{{ ai_gen_id }}__button').forEach((button) => {
          button.addEventListener('click', () => {
            const card = this.track.querySelector('.ai-review-carousel-{{ ai_gen_id }}__card');
            if (!card) return;
            const gap = parseFloat(getComputedStyle(this.track).columnGap) || 0;
            const distance = card.getBoundingClientRect().width + gap;
            const direction = button.dataset.direction === 'next' ? -1 : 1;
            this.track.scrollBy({ left: direction * distance, behavior: 'smooth' });
          });
        });
      }
    }
    customElements.define(tagName, ReviewCarousel);
  })();
</script>

