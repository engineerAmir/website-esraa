{{ 'product-editorial.css' | asset_url | stylesheet_tag }}
<div class="pdp-story" style="--pdp-story-background: {{ section.settings.background }}; --pdp-divider-spacing: {{ section.settings.divider_spacing }}px;">
  {% if section.settings.show_features %}{% render 'product-editorial-items', item_settings: section.settings, class: 'pdp-items--features' %}{% endif %}
  <div class="pdp-detail-grid">
    {% for i in (1..4) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign caption_key = 'caption_' | append: i
        assign detail_image = section.settings[image_key]
        assign image_alt = detail_image.alt | default: section.settings[caption_key]
      %}
      {% if detail_image != blank %}
        <figure>
          {{ detail_image | image_url: width: 1000 | image_tag: widths: '240, 360, 500, 750, 1000', sizes: '(min-width: 990px) 23vw, 46vw', loading: 'lazy', alt: image_alt }}
          {% if section.settings[caption_key] != blank %}<figcaption>{{ section.settings[caption_key] | escape }}</figcaption>{% endif %}
        </figure>
      {% endif %}
    {% endfor %}
  </div>
  {% if section.settings.divider != blank %}<div class="pdp-editorial-divider"><span>{{ section.settings.divider | escape }}</span></div>{% endif %}
</div>
