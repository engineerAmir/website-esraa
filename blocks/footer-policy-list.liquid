{% doc %}
  @prompt
    Add a small "Developed by ENG.Amir" text with a hyperlink to https://engamir.scale-up.website/en/ in the footer, styled to match the existing footer design.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-developed-by-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    font-family: inherit;
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.5;
    text-align: {{ block.settings.alignment }};
    padding: {{ block.settings.vertical_spacing }}px 0;
  }

  .ai-developed-by-{{ ai_gen_id }}__link {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: opacity 0.2s ease;
  }

  .ai-developed-by-{{ ai_gen_id }}__link:hover,
  .ai-developed-by-{{ ai_gen_id }}__link:focus-visible {
    opacity: 0.72;
  }

  .ai-developed-by-{{ ai_gen_id }}__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
{% endstyle %}

<div class="ai-developed-by-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <a
    class="ai-developed-by-{{ ai_gen_id }}__link"
    href="https://engamir.scale-up.website/en/"
    target="_blank"
    rel="noopener noreferrer"
  >
    {{ block.settings.label }}
  </a>
</div>

{% schema %}
{
  "name": "Developed by credit",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Text",
      "default": "Developed by ENG.Amir"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Text size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "vertical_spacing",
      "label": "Vertical spacing",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#6d263d"
    }
  ],
  "presets": [
    {
      "name": "Developed by credit"
    }
  ],
  "tag": null,
  "class": "developed-by-credit-block"
}
{% endschema %}