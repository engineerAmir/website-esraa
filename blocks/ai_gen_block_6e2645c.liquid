{% doc %}
  @prompt
    last visit products 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-recent-products-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
  }

  .ai-recent-products-{{ ai_gen_id }}__heading {
    margin: 0 0 24px;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_heading_font.family }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
    text-align: {{ block.settings.alignment }};
  }

  .ai-recent-products-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns }}, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
  }

  .ai-recent-products-{{ ai_gen_id }}__card {
    min-width: 0;
    color: {{ block.settings.text_color }};
    text-decoration: none;
  }

  .ai-recent-products-{{ ai_gen_id }}__image-wrap {
    aspect-ratio: 1 / 1.2;
    overflow: hidden;
    background: {{ block.settings.image_background }};
    border-radius: {{ block.settings.card_radius }}px;
  }

  .ai-recent-products-{{ ai_gen_id }}__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .ai-recent-products-{{ ai_gen_id }}__info {
    padding-top: 12px;
  }

  .ai-recent-products-{{ ai_gen_id }}__title,
  .ai-recent-products-{{ ai_gen_id }}__price {
    margin: 0;
    font-family: {{ settings.type_body_font.family }};
  }

  .ai-recent-products-{{ ai_gen_id }}__title {
    font-size: 14px;
    line-height: 1.4;
  }

  .ai-recent-products-{{ ai_gen_id }}__price {
    margin-top: 5px;
    font-size: 13px;
  }

  .ai-recent-products-{{ ai_gen_id }}__empty {
    padding: 28px;
    border: 1px solid {{ block.settings.text_color }};
    text-align: center;
    font-family: {{ settings.type_body_font.family }};
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-recent-products-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.mobile_columns }}, minmax(0, 1fr));
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-recent-products-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }
  }
{% endstyle %}

<recent-products-{{ ai_gen_id }} class="ai-recent-products-{{ ai_gen_id }}" data-limit="{{ block.settings.product_limit }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-recent-products-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}
  <div class="ai-recent-products-{{ ai_gen_id }}__grid" data-recent-grid>
    <div class="ai-recent-products-{{ ai_gen_id }}__empty" data-recent-empty>{{ block.settings.empty_message | escape }}</div>
  </div>
</recent-products-{{ ai_gen_id }}>

<script>
  (function() {
    class RecentProducts{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.grid = this.querySelector('[data-recent-grid]');
        this.empty = this.querySelector('[data-recent-empty]');
        this.limit = Number(this.dataset.limit) || 4;
        this.loadProducts();
      }

      async loadProducts() {
        let handles = [];
        try {
          handles = JSON.parse(localStorage.getItem('recently-viewed-products') || '[]');
        } catch (error) {
          handles = [];
        }
        handles = handles.filter(Boolean).slice(0, this.limit);
        if (!handles.length) return;

        const products = await Promise.all(handles.map(async (handle) => {
          try {
            const response = await fetch('/products/' + encodeURIComponent(handle) + '.js');
            return response.ok ? await response.json() : null;
          } catch (error) {
            return null;
          }
        }));

        const validProducts = products.filter(Boolean);
        if (!validProducts.length) return;
        this.empty.remove();
        validProducts.forEach((product) => {
          const card = document.createElement('a');
          card.className = 'ai-recent-products-{{ ai_gen_id }}__card';
          card.href = product.url;
          const image = product.featured_image || (product.images && product.images[0]);
          const imageMarkup = image ? '<img class="ai-recent-products-{{ ai_gen_id }}__image" src="' + image + '" alt="' + this.escape(product.title) + '" loading="lazy">' : '';
          card.innerHTML = '<div class="ai-recent-products-{{ ai_gen_id }}__image-wrap">' + imageMarkup + '</div><div class="ai-recent-products-{{ ai_gen_id }}__info"><p class="ai-recent-products-{{ ai_gen_id }}__title">' + this.escape(product.title) + '</p><p class="ai-recent-products-{{ ai_gen_id }}__price">' + this.formatMoney(product.price) + '</p></div>';
          this.grid.appendChild(card);
        });
      }

      escape(value) {
        const div = document.createElement('div');
        div.textContent = value || '';
        return div.innerHTML;
      }

      formatMoney(value) {
        return new Intl.NumberFormat('{{ shop.locale }}', { style: 'currency', currency: '{{ shop.currency }}' }).format(value / 100);
      }
    }
    customElements.define('recent-products-{{ ai_gen_id }}', RecentProducts{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Recently viewed products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" },
    { "type": "text", "id": "empty_message", "label": "Empty message", "default": "Products you view will appear here." },
    { "type": "range", "id": "product_limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "columns", "label": "Columns", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "4" },
    { "type": "select", "id": "mobile_columns", "label": "Columns on mobile", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "radio", "id": "alignment", "label": "Alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 18, "max": 48, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 16, "max": 32, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "gap", "label": "Grid gap", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "mobile_gap", "label": "Mobile grid gap", "min": 8, "max": 24, "step": 4, "unit": "px", "default": 12 },
    { "type": "range", "id": "card_radius", "label": "Image radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 10 },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#6d263d" },
    { "type": "color", "id": "image_background", "label": "Image background", "default": "#f7f2ec" }
  ],
  "presets": [{ "name": "Recently viewed products" }],
  "tag": null,
  "class": "recently-viewed-products-block"
}
{% endschema %}