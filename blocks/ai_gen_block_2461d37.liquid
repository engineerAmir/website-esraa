{% liquid
  assign feature_1_title = product.metafields.custom.feature_1_title.value
  assign feature_1_text = product.metafields.custom.feature_1_text.value

  assign feature_2_title = product.metafields.custom.feature_2_title.value
  assign feature_2_text = product.metafields.custom.feature_2_text.value

  assign feature_3_title = product.metafields.custom.feature_3_title.value
  assign feature_3_text = product.metafields.custom.feature_3_text.value

  assign feature_4_title = product.metafields.custom.feature_4_title.value
  assign feature_4_text = product.metafields.custom.feature_4_text.value

  assign embroidery_image = product.metafields.custom.embroidery_detail_image.value
  assign neck_image = product.metafields.custom.neck_detail_image.value
  assign sleeve_image = product.metafields.custom.sleeve_detail_image.value
  assign back_image = product.metafields.custom.back_view_image.value

  assign has_features = false
  if feature_1_title != blank or feature_1_text != blank or feature_2_title != blank or feature_2_text != blank or feature_3_title != blank or feature_3_text != blank or feature_4_title != blank or feature_4_text != blank
    assign has_features = true
  endif

  assign has_gallery = false
  if embroidery_image != blank or neck_image != blank or sleeve_image != blank or back_image != blank
    assign has_gallery = true
  endif
%}

{% if has_features or has_gallery %}

<style>
  #ProductEditorial-{{ section.id }} {
    --background: {{ section.settings.background }};
    --feature-background: {{ section.settings.feature_background }};
    --text-color: {{ section.settings.text_color }};
    --muted-color: {{ section.settings.muted_color }};
    --border-color: {{ section.settings.border_color }};
    --image-radius: {{ section.settings.image_radius }}px;
    --grid-gap: {{ section.settings.grid_gap }}px;

    width: 100%;
    background: var(--background);
    color: var(--text-color);

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #ProductEditorial-{{ section.id }} * {
    box-sizing: border-box;
  }

  #ProductEditorial-{{ section.id }} .pdp-story__inner {
    width:
      {% if section.settings.width_mode == 'full' %}
        calc(100% - 32px)
      {% else %}
        calc(100% - 48px)
      {% endif %};

    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  /* ==========================================================
     FEATURE BAR
  ========================================================== */

  #ProductEditorial-{{ section.id }} .pdp-items {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));

    background: var(--feature-background);

    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);

    margin: 0 0 {{ section.settings.feature_gallery_spacing }}px;
  }

  #ProductEditorial-{{ section.id }} .pdp-item {
    min-width: 0;

    display: flex;
    align-items: center;

    gap: 13px;

    min-height: 78px;

    padding: 16px 22px;

    border-right: 1px solid var(--border-color);
  }

  #ProductEditorial-{{ section.id }} .pdp-item:last-child {
    border-right: 0;
  }

  #ProductEditorial-{{ section.id }} .pdp-item__icon {
    flex: 0 0 22px;

    width: 22px;
    height: 22px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: var(--text-color);

    opacity: .72;
  }

  #ProductEditorial-{{ section.id }} .pdp-item__icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #ProductEditorial-{{ section.id }} .pdp-item__content {
    min-width: 0;
  }

  #ProductEditorial-{{ section.id }} .pdp-item__title {
    margin: 0;

    color: var(--text-color);

    font-family: inherit;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
  }

  #ProductEditorial-{{ section.id }} .pdp-item__description {
    margin: 4px 0 0;

    color: var(--muted-color);

    font-family: inherit;
    font-size: 9px;
    font-weight: 400;
    line-height: 1.4;
  }

  /* ==========================================================
     DETAIL GRID
  ========================================================== */

  #ProductEditorial-{{ section.id }} .pdp-detail-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: var(--grid-gap);

    width: 100%;
  }

  #ProductEditorial-{{ section.id }} .pdp-detail-card {
    min-width: 0;
    margin: 0;
  }

  #ProductEditorial-{{ section.id }} .pdp-detail-card__media {
    position: relative;

    width: 100%;
    height: {{ section.settings.desktop_image_height }}px;

    overflow: hidden;

    border-radius: var(--image-radius);

    background: #eeeae5;
  }

  #ProductEditorial-{{ section.id }} .pdp-detail-card__media img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    transition: transform .7s cubic-bezier(.2,.65,.3,1);
  }

  #ProductEditorial-{{ section.id }} .pdp-detail-card:hover img {
    transform: scale(1.025);
  }

  #ProductEditorial-{{ section.id }} .pdp-detail-card figcaption {
    margin-top: 10px;

    color: var(--text-color);

    text-align: center;

    font-family: inherit;
    font-size: 10px;
    font-weight: 400;
    line-height: 1.4;

    letter-spacing: .02em;
  }

  /* ==========================================================
     EDITORIAL DIVIDER
  ========================================================== */

  #ProductEditorial-{{ section.id }} .pdp-editorial-divider {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 18px;

    width: 100%;

    margin-top: {{ section.settings.divider_spacing }}px;
  }

  #ProductEditorial-{{ section.id }} .pdp-editorial-divider::before,
  #ProductEditorial-{{ section.id }} .pdp-editorial-divider::after {
    content: "";

    flex: 1;

    height: 1px;

    background: var(--border-color);
  }

  #ProductEditorial-{{ section.id }} .pdp-editorial-divider span {
    display: inline-block;

    padding: 0 10px;

    color: var(--muted-color);

    font-size: 9px;
    font-weight: 500;
    line-height: 1;

    letter-spacing: .2em;

    text-transform: uppercase;

    white-space: nowrap;
  }

  /* ==========================================================
     TABLET
  ========================================================== */

  @media screen and (max-width: 989px) {

    #ProductEditorial-{{ section.id }} .pdp-story__inner {
      width: calc(100% - 30px);
    }

    #ProductEditorial-{{ section.id }} .pdp-items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #ProductEditorial-{{ section.id }} .pdp-item:nth-child(2n) {
      border-right: 0;
    }

    #ProductEditorial-{{ section.id }} .pdp-item:nth-child(-n + 2) {
      border-bottom: 1px solid var(--border-color);
    }

    #ProductEditorial-{{ section.id }} .pdp-detail-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #ProductEditorial-{{ section.id }} .pdp-detail-card__media {
      height: 52vw;
      max-height: 520px;
    }
  }

  /* ==========================================================
     MOBILE
  ========================================================== */

  @media screen and (max-width: 749px) {

    #ProductEditorial-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #ProductEditorial-{{ section.id }} .pdp-story__inner {
      width: calc(100% - 20px);
    }

    #ProductEditorial-{{ section.id }} .pdp-items {
      margin-bottom: 12px;
    }

    #ProductEditorial-{{ section.id }} .pdp-item {
      min-height: 72px;

      gap: 9px;

      padding: 12px 10px;
    }

    #ProductEditorial-{{ section.id }} .pdp-item__icon {
      flex-basis: 18px;

      width: 18px;
      height: 18px;
    }

    #ProductEditorial-{{ section.id }} .pdp-item__title {
      font-size: 10px;
    }

    #ProductEditorial-{{ section.id }} .pdp-item__description {
      margin-top: 3px;

      font-size: 8px;

      line-height: 1.35;
    }

    #ProductEditorial-{{ section.id }} .pdp-detail-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));

      gap: 8px;
    }

    #ProductEditorial-{{ section.id }} .pdp-detail-card__media {
      height: auto;

      aspect-ratio: {{ section.settings.mobile_image_ratio }};
    }

    #ProductEditorial-{{ section.id }} .pdp-detail-card figcaption {
      margin-top: 6px;

      font-size: 9px;
    }

    #ProductEditorial-{{ section.id }} .pdp-editorial-divider {
      gap: 10px;

      margin-top: {{ section.settings.mobile_divider_spacing }}px;
    }

    #ProductEditorial-{{ section.id }} .pdp-editorial-divider span {
      font-size: 8px;

      letter-spacing: .14em;

      padding: 0 5px;
    }
  }

  @media screen and (max-width: 380px) {

    #ProductEditorial-{{ section.id }} .pdp-item {
      min-height: 64px;

      padding: 10px 8px;
    }

    #ProductEditorial-{{ section.id }} .pdp-item__description {
      display: none;
    }
  }
</style>


<section
  id="ProductEditorial-{{ section.id }}"
  class="pdp-story"
  {{ section.shopify_attributes }}
>
  <div class="pdp-story__inner">

    {% if section.settings.show_features and has_features %}

      <div class="pdp-items pdp-items--features">

        {% if feature_1_title != blank or feature_1_text != blank %}

          <div class="pdp-item">

            <span class="pdp-item__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 4c-7 0-12 3.5-12 9 0 2.5 1.5 4.5 4 5"/>
                <path d="M8 20c2-5 5-8 10-11"/>
                <path d="M11 18c4 0 7-3 8-8"/>
              </svg>
            </span>

            <div class="pdp-item__content">

              {% if feature_1_title != blank %}
                <p class="pdp-item__title">
                  {{ feature_1_title | escape }}
                </p>
              {% endif %}

              {% if feature_1_text != blank %}
                <p class="pdp-item__description">
                  {{ feature_1_text | escape }}
                </p>
              {% endif %}

            </div>

          </div>

        {% endif %}


        {% if feature_2_title != blank or feature_2_text != blank %}

          <div class="pdp-item">

            <span class="pdp-item__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="2"/>
                <path d="M12 4c2-2 5-1 5 2 0 2-2 3-5 4"/>
                <path d="M20 12c2 2 1 5-2 5-2 0-3-2-4-5"/>
                <path d="M12 20c-2 2-5 1-5-2 0-2 2-3 5-4"/>
                <path d="M4 12c-2-2-1-5 2-5 2 0 3 2 4 5"/>
              </svg>
            </span>

            <div class="pdp-item__content">

              {% if feature_2_title != blank %}
                <p class="pdp-item__title">
                  {{ feature_2_title | escape }}
                </p>
              {% endif %}

              {% if feature_2_text != blank %}
                <p class="pdp-item__description">
                  {{ feature_2_text | escape }}
                </p>
              {% endif %}

            </div>

          </div>

        {% endif %}


        {% if feature_3_title != blank or feature_3_text != blank %}

          <div class="pdp-item">

            <span class="pdp-item__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M9 3h6"/>
                <path d="M10 3c0 2-1 3-3 4l-2 13h14L17 7c-2-1-3-2-3-4"/>
                <path d="M8 10h8"/>
              </svg>
            </span>

            <div class="pdp-item__content">

              {% if feature_3_title != blank %}
                <p class="pdp-item__title">
                  {{ feature_3_title | escape }}
                </p>
              {% endif %}

              {% if feature_3_text != blank %}
                <p class="pdp-item__description">
                  {{ feature_3_text | escape }}
                </p>
              {% endif %}

            </div>

          </div>

        {% endif %}


        {% if feature_4_title != blank or feature_4_text != blank %}

          <div class="pdp-item">

            <span class="pdp-item__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m12 3 2.4 5.2 5.6.7-4.1 3.7 1.1 5.5-5-2.8-5 2.8 1.1-5.5L4 8.9l5.6-.7L12 3Z"/>
              </svg>
            </span>

            <div class="pdp-item__content">

              {% if feature_4_title != blank %}
                <p class="pdp-item__title">
                  {{ feature_4_title | escape }}
                </p>
              {% endif %}

              {% if feature_4_text != blank %}
                <p class="pdp-item__description">
                  {{ feature_4_text | escape }}
                </p>
              {% endif %}

            </div>

          </div>

        {% endif %}

      </div>

    {% endif %}


    {% if has_gallery %}

      <div class="pdp-detail-grid">

        {% if embroidery_image != blank %}

          <figure class="pdp-detail-card">

            <div class="pdp-detail-card__media">

              {{
                embroidery_image
                | image_url: width: 1200
                | image_tag:
                  widths: '300, 450, 600, 750, 900, 1200',
                  sizes: '(min-width: 990px) 24vw, 48vw',
                  loading: 'lazy',
                  alt: 'Embroidery detail'
              }}

            </div>

            {% if section.settings.show_captions %}
              <figcaption>
                Embroidery Detail
              </figcaption>
            {% endif %}

          </figure>

        {% endif %}


        {% if neck_image != blank %}

          <figure class="pdp-detail-card">

            <div class="pdp-detail-card__media">

              {{
                neck_image
                | image_url: width: 1200
                | image_tag:
                  widths: '300, 450, 600, 750, 900, 1200',
                  sizes: '(min-width: 990px) 24vw, 48vw',
                  loading: 'lazy',
                  alt: 'Neck detail'
              }}

            </div>

            {% if section.settings.show_captions %}
              <figcaption>
                Neck Detail
              </figcaption>
            {% endif %}

          </figure>

        {% endif %}


        {% if sleeve_image != blank %}

          <figure class="pdp-detail-card">

            <div class="pdp-detail-card__media">

              {{
                sleeve_image
                | image_url: width: 1200
                | image_tag:
                  widths: '300, 450, 600, 750, 900, 1200',
                  sizes: '(min-width: 990px) 24vw, 48vw',
                  loading: 'lazy',
                  alt: 'Sleeve detail'
              }}

            </div>

            {% if section.settings.show_captions %}
              <figcaption>
                Sleeve Detail
              </figcaption>
            {% endif %}

          </figure>

        {% endif %}


        {% if back_image != blank %}

          <figure class="pdp-detail-card">

            <div class="pdp-detail-card__media">

              {{
                back_image
                | image_url: width: 1200
                | image_tag:
                  widths: '300, 450, 600, 750, 900, 1200',
                  sizes: '(min-width: 990px) 24vw, 48vw',
                  loading: 'lazy',
                  alt: 'Back view'
              }}

            </div>

            {% if section.settings.show_captions %}
              <figcaption>
                Back View
              </figcaption>
            {% endif %}

          </figure>

        {% endif %}

      </div>

    {% endif %}


    {% if section.settings.show_divider and section.settings.divider != blank %}

      <div class="pdp-editorial-divider">
        <span>
          {{ section.settings.divider | escape }}
        </span>
      </div>

    {% endif %}

  </div>
</section>

{% endif %}


{% schema %}
{
  "name": "Product storytelling",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width_mode",
      "label": "Width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "default": 1450
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Image gap",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 10
    },

    {
      "type": "header",
      "content": "Features"
    },
    {
      "type": "checkbox",
      "id": "show_features",
      "label": "Show features",
      "default": true
    },
    {
      "type": "range",
      "id": "feature_gallery_spacing",
      "label": "Space below features",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 16
    },

    {
      "type": "header",
      "content": "Detail photography"
    },
    {
      "type": "checkbox",
      "id": "show_captions",
      "label": "Show image captions",
      "default": true
    },
    {
      "type": "range",
      "id": "desktop_image_height",
      "label": "Desktop image height",
      "min": 250,
      "max": 650,
      "step": 10,
      "unit": "px",
      "default": 420
    },
    {
      "type": "select",
      "id": "mobile_image_ratio",
      "label": "Mobile image ratio",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "Portrait 4:5"
        },
        {
          "value": "3 / 4",
          "label": "Portrait 3:4"
        },
        {
          "value": "2 / 3",
          "label": "Portrait 2:3"
        }
      ],
      "default": "3 / 4"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 2
    },

    {
      "type": "header",
      "content": "Editorial divider"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider",
      "default": true
    },
    {
      "type": "text",
      "id": "divider",
      "label": "Divider text",
      "default": "TIMELESS ELEGANCE"
    },
    {
      "type": "range",
      "id": "divider_spacing",
      "label": "Desktop divider spacing",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_divider_spacing",
      "label": "Mobile divider spacing",
      "min": 12,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 28
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "feature_background",
      "label": "Features background",
      "default": "#f8f7f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#2d2926"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Secondary text",
      "default": "#827b77"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#ded9d3"
    },

    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Product storytelling"
    }
  ]
}
{% endschema %}