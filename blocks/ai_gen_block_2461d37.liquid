{{ 'product-editorial.css' | asset_url | stylesheet_tag }}

{% liquid
  comment
    ============================================================
    PRODUCT METAFIELDS
    Namespace assumed: custom
    ============================================================
  endcomment

  assign back_view_image = product.metafields.custom.back_view_image.value
  assign sleeve_detail_image = product.metafields.custom.sleeve_detail_image.value
  assign neck_detail_image = product.metafields.custom.neck_detail_image.value
  assign embroidery_detail_image = product.metafields.custom.embroidery_detail_image.value

  assign feature_1_title = product.metafields.custom.feature_1_title.value
  assign feature_1_text = product.metafields.custom.feature_1_text.value

  assign feature_2_title = product.metafields.custom.feature_2_title.value
  assign feature_2_text = product.metafields.custom.feature_2_text.value

  assign feature_3_title = product.metafields.custom.feature_3_title.value
  assign feature_3_text = product.metafields.custom.feature_3_text.value

  assign feature_4_title = product.metafields.custom.feature_4_title.value
  assign feature_4_text = product.metafields.custom.feature_4_text.value

  assign model_height = product.metafields.custom.model_height.value
  assign model_size = product.metafields.custom.model_size.value

  assign care_instructions = product.metafields.custom.care_instructions.value
  assign fit = product.metafields.custom.fit.value
  assign fabric_material = product.metafields.custom.fabric_material.value

  assign short_description = product.metafields.custom.short_description.value
%}

<section
  class="pdp-story"
  style="
    --pdp-story-background: {{ section.settings.background }};
    --pdp-divider-spacing: {{ section.settings.divider_spacing }}px;
  "
>

  {% comment %}
    =========================
    SHORT DESCRIPTION
    =========================
  {% endcomment %}

  {% if section.settings.show_intro and short_description != blank %}
    <div class="pdp-story__intro">
      {% if section.settings.eyebrow != blank %}
        <span class="pdp-story__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="pdp-story__heading">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}

      <div class="pdp-story__description">
        {{ short_description }}
      </div>
    </div>
  {% endif %}


  {% comment %}
    =========================
    PRODUCT FEATURES
    =========================
  {% endcomment %}

  {% if section.settings.show_features %}

    {% if feature_1_title != blank
      or feature_2_title != blank
      or feature_3_title != blank
      or feature_4_title != blank
    %}

      <div class="pdp-items pdp-items--features">

        {% if feature_1_title != blank or feature_1_text != blank %}
          <div class="pdp-feature-item">

            <div class="pdp-feature-icon">
              {% render 'product-editorial-icon',
                icon: section.settings.icon_1
              %}
            </div>

            <div class="pdp-feature-content">
              {% if feature_1_title != blank %}
                <h3>
                  {{ feature_1_title | escape }}
                </h3>
              {% endif %}

              {% if feature_1_text != blank %}
                <p>
                  {{ feature_1_text | escape }}
                </p>
              {% endif %}
            </div>

          </div>
        {% endif %}


        {% if feature_2_title != blank or feature_2_text != blank %}
          <div class="pdp-feature-item">

            <div class="pdp-feature-icon">
              {% render 'product-editorial-icon',
                icon: section.settings.icon_2
              %}
            </div>

            <div class="pdp-feature-content">
              {% if feature_2_title != blank %}
                <h3>
                  {{ feature_2_title | escape }}
                </h3>
              {% endif %}

              {% if feature_2_text != blank %}
                <p>
                  {{ feature_2_text | escape }}
                </p>
              {% endif %}
            </div>

          </div>
        {% endif %}


        {% if feature_3_title != blank or feature_3_text != blank %}
          <div class="pdp-feature-item">

            <div class="pdp-feature-icon">
              {% render 'product-editorial-icon',
                icon: section.settings.icon_3
              %}
            </div>

            <div class="pdp-feature-content">
              {% if feature_3_title != blank %}
                <h3>
                  {{ feature_3_title | escape }}
                </h3>
              {% endif %}

              {% if feature_3_text != blank %}
                <p>
                  {{ feature_3_text | escape }}
                </p>
              {% endif %}
            </div>

          </div>
        {% endif %}


        {% if feature_4_title != blank or feature_4_text != blank %}
          <div class="pdp-feature-item">

            <div class="pdp-feature-icon">
              {% render 'product-editorial-icon',
                icon: section.settings.icon_4
              %}
            </div>

            <div class="pdp-feature-content">
              {% if feature_4_title != blank %}
                <h3>
                  {{ feature_4_title | escape }}
                </h3>
              {% endif %}

              {% if feature_4_text != blank %}
                <p>
                  {{ feature_4_text | escape }}
                </p>
              {% endif %}
            </div>

          </div>
        {% endif %}

      </div>

    {% endif %}
  {% endif %}


  {% comment %}
    =========================
    PRODUCT DETAILS / SPECS
    =========================
  {% endcomment %}

  {% if section.settings.show_product_details %}

    {% if fabric_material != blank
      or fit != blank
      or model_height != blank
      or model_size != blank
      or care_instructions != blank
    %}

      <div class="pdp-product-info">

        {% if section.settings.details_heading != blank %}
          <h2 class="pdp-product-info__heading">
            {{ section.settings.details_heading | escape }}
          </h2>
        {% endif %}


        <div class="pdp-product-info__grid">

          {% if fabric_material != blank %}
            <div class="pdp-product-info__item">
              <span class="pdp-product-info__label">
                Fabric / Material
              </span>

              <span class="pdp-product-info__value">
                {{ fabric_material | escape }}
              </span>
            </div>
          {% endif %}


          {% if fit != blank %}
            <div class="pdp-product-info__item">
              <span class="pdp-product-info__label">
                Fit
              </span>

              <span class="pdp-product-info__value">
                {{ fit | escape }}
              </span>
            </div>
          {% endif %}


          {% if model_height != blank %}
            <div class="pdp-product-info__item">
              <span class="pdp-product-info__label">
                Model Height
              </span>

              <span class="pdp-product-info__value">
                {{ model_height | escape }}
              </span>
            </div>
          {% endif %}


          {% if model_size != blank %}
            <div class="pdp-product-info__item">
              <span class="pdp-product-info__label">
                Model Size
              </span>

              <span class="pdp-product-info__value">
                {{ model_size | escape }}
              </span>
            </div>
          {% endif %}


          {% if care_instructions != blank %}
            <div class="pdp-product-info__item pdp-product-info__item--wide">
              <span class="pdp-product-info__label">
                Care Instructions
              </span>

              <span class="pdp-product-info__value">
                {{ care_instructions | escape }}
              </span>
            </div>
          {% endif %}

        </div>

      </div>

    {% endif %}
  {% endif %}


  {% comment %}
    =========================
    DETAIL PHOTOGRAPHY
    =========================
  {% endcomment %}

  {% if section.settings.show_detail_images %}

    {% if back_view_image != blank
      or sleeve_detail_image != blank
      or neck_detail_image != blank
      or embroidery_detail_image != blank
    %}

      <div class="pdp-detail-grid">

        {% if back_view_image != blank %}
          <figure class="pdp-detail-card">

            {{
              back_view_image
              | image_url: width: 1400
              | image_tag:
                widths: '300, 450, 600, 800, 1000, 1200, 1400',
                sizes: '(min-width: 990px) 25vw, 50vw',
                loading: 'lazy',
                class: 'pdp-detail-card__image',
                alt: 'Back view'
            }}

            {% if section.settings.show_image_captions %}
              <figcaption>
                Back View
              </figcaption>
            {% endif %}

          </figure>
        {% endif %}


        {% if sleeve_detail_image != blank %}
          <figure class="pdp-detail-card">

            {{
              sleeve_detail_image
              | image_url: width: 1400
              | image_tag:
                widths: '300, 450, 600, 800, 1000, 1200, 1400',
                sizes: '(min-width: 990px) 25vw, 50vw',
                loading: 'lazy',
                class: 'pdp-detail-card__image',
                alt: 'Sleeve detail'
            }}

            {% if section.settings.show_image_captions %}
              <figcaption>
                Sleeve Detail
              </figcaption>
            {% endif %}

          </figure>
        {% endif %}


        {% if neck_detail_image != blank %}
          <figure class="pdp-detail-card">

            {{
              neck_detail_image
              | image_url: width: 1400
              | image_tag:
                widths: '300, 450, 600, 800, 1000, 1200, 1400',
                sizes: '(min-width: 990px) 25vw, 50vw',
                loading: 'lazy',
                class: 'pdp-detail-card__image',
                alt: 'Neck detail'
            }}

            {% if section.settings.show_image_captions %}
              <figcaption>
                Neck Detail
              </figcaption>
            {% endif %}

          </figure>
        {% endif %}


        {% if embroidery_detail_image != blank %}
          <figure class="pdp-detail-card">

            {{
              embroidery_detail_image
              | image_url: width: 1400
              | image_tag:
                widths: '300, 450, 600, 800, 1000, 1200, 1400',
                sizes: '(min-width: 990px) 25vw, 50vw',
                loading: 'lazy',
                class: 'pdp-detail-card__image',
                alt: 'Embroidery detail'
            }}

            {% if section.settings.show_image_captions %}
              <figcaption>
                Embroidery Detail
              </figcaption>
            {% endif %}

          </figure>
        {% endif %}

      </div>

    {% endif %}

  {% endif %}


  {% comment %}
    =========================
    EDITORIAL DIVIDER
    =========================
  {% endcomment %}

  {% if section.settings.divider != blank %}
    <div class="pdp-editorial-divider">
      <span>
        {{ section.settings.divider | escape }}
      </span>
    </div>
  {% endif %}

</section>


{% style %}

  #shopify-section-{{ section.id }} .pdp-story {
    background: var(--pdp-story-background);
    padding:
      {{ section.settings.padding_top }}px
      {{ section.settings.horizontal_padding }}px
      {{ section.settings.padding_bottom }}px;
  }


  /* =========================
     INTRO
  ========================= */

  #shopify-section-{{ section.id }} .pdp-story__intro {
    max-width: 760px;
    margin: 0 auto 48px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .pdp-story__eyebrow {
    display: block;
    margin-bottom: 12px;

    font-size: 11px;
    line-height: 1.2;
    letter-spacing: 0.18em;
    text-transform: uppercase;

    opacity: 0.65;
  }

  #shopify-section-{{ section.id }} .pdp-story__heading {
    margin: 0 0 16px;

    font-size: clamp(28px, 4vw, 48px);
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  #shopify-section-{{ section.id }} .pdp-story__description {
    font-size: 15px;
    line-height: 1.75;
    opacity: 0.75;
  }


  /* =========================
     FEATURES
  ========================= */

  #shopify-section-{{ section.id }} .pdp-items--features {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));

    max-width: 1400px;

    margin:
      0
      auto
      {{ section.settings.feature_bottom_spacing }}px;

    border-top: 1px solid rgba(0, 0, 0, 0.12);
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
  }


  #shopify-section-{{ section.id }} .pdp-feature-item {
    min-width: 0;

    padding: 28px 24px;

    display: flex;
    align-items: flex-start;
    gap: 16px;

    border-right: 1px solid rgba(0, 0, 0, 0.12);
  }


  #shopify-section-{{ section.id }} .pdp-feature-item:last-child {
    border-right: 0;
  }


  #shopify-section-{{ section.id }} .pdp-feature-icon {
    flex: 0 0 auto;

    width: 28px;
    height: 28px;

    display: flex;
    align-items: center;
    justify-content: center;
  }


  #shopify-section-{{ section.id }} .pdp-feature-icon svg {
    width: 22px;
    height: 22px;
  }


  #shopify-section-{{ section.id }} .pdp-feature-content {
    min-width: 0;
  }


  #shopify-section-{{ section.id }} .pdp-feature-content h3 {
    margin: 0 0 6px;

    font-size: 14px;
    line-height: 1.3;
    font-weight: 500;
  }


  #shopify-section-{{ section.id }} .pdp-feature-content p {
    margin: 0;

    font-size: 13px;
    line-height: 1.55;

    opacity: 0.68;
  }


  /* =========================
     PRODUCT INFORMATION
  ========================= */

  #shopify-section-{{ section.id }} .pdp-product-info {
    max-width: 1400px;

    margin:
      0
      auto
      {{ section.settings.details_bottom_spacing }}px;
  }


  #shopify-section-{{ section.id }} .pdp-product-info__heading {
    margin: 0 0 22px;

    font-size: clamp(22px, 3vw, 32px);
    line-height: 1.2;
    font-weight: 500;
  }


  #shopify-section-{{ section.id }} .pdp-product-info__grid {
    display: grid;

    grid-template-columns:
      repeat(4, minmax(0, 1fr));

    border-top: 1px solid rgba(0, 0, 0, 0.12);
  }


  #shopify-section-{{ section.id }} .pdp-product-info__item {
    display: flex;
    flex-direction: column;
    gap: 8px;

    padding: 20px 16px 20px 0;

    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
  }


  #shopify-section-{{ section.id }} .pdp-product-info__item--wide {
    grid-column: span 4;
  }


  #shopify-section-{{ section.id }} .pdp-product-info__label {
    font-size: 11px;
    line-height: 1.2;

    text-transform: uppercase;
    letter-spacing: 0.1em;

    opacity: 0.5;
  }


  #shopify-section-{{ section.id }} .pdp-product-info__value {
    font-size: 14px;
    line-height: 1.55;
  }


  /* =========================
     DETAIL IMAGE GRID
  ========================= */

  #shopify-section-{{ section.id }} .pdp-detail-grid {
    display: grid;

    grid-template-columns:
      repeat(4, minmax(0, 1fr));

    gap: {{ section.settings.image_gap }}px;

    max-width: 1600px;

    margin: 0 auto;
  }


  #shopify-section-{{ section.id }} .pdp-detail-card {
    position: relative;

    margin: 0;

    min-width: 0;

    overflow: hidden;

    background: #eeeeea;
  }


  #shopify-section-{{ section.id }} .pdp-detail-card__image {
    display: block;

    width: 100%;

    aspect-ratio:
      {{ section.settings.image_ratio_width }}
      /
      {{ section.settings.image_ratio_height }};

    object-fit: {{ section.settings.image_fit }};

    transition:
      transform 0.8s cubic-bezier(.2,.6,.2,1);
  }


  #shopify-section-{{ section.id }} .pdp-detail-card:hover .pdp-detail-card__image {
    transform: scale(1.025);
  }


  #shopify-section-{{ section.id }} .pdp-detail-card figcaption {
    padding: 12px 2px 0;

    font-size: 11px;
    line-height: 1.3;

    text-transform: uppercase;
    letter-spacing: 0.1em;

    background: var(--pdp-story-background);

    opacity: 0.65;
  }


  /* =========================
     DIVIDER
  ========================= */

  #shopify-section-{{ section.id }} .pdp-editorial-divider {
    display: flex;
    align-items: center;

    gap: 20px;

    margin-top: var(--pdp-divider-spacing);

    overflow: hidden;
  }


  #shopify-section-{{ section.id }} .pdp-editorial-divider::before,
  #shopify-section-{{ section.id }} .pdp-editorial-divider::after {
    content: "";

    flex: 1;

    height: 1px;

    background: rgba(0, 0, 0, 0.14);
  }


  #shopify-section-{{ section.id }} .pdp-editorial-divider span {
    flex: 0 0 auto;

    font-size: 10px;
    line-height: 1;

    letter-spacing: 0.18em;
    text-transform: uppercase;

    opacity: 0.55;
  }


  /* =========================
     TABLET
  ========================= */

  @media screen and (max-width: 989px) {

    #shopify-section-{{ section.id }} .pdp-items--features {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }


    #shopify-section-{{ section.id }} .pdp-feature-item:nth-child(2n) {
      border-right: 0;
    }


    #shopify-section-{{ section.id }} .pdp-feature-item:nth-child(-n + 2) {
      border-bottom: 1px solid rgba(0, 0, 0, 0.12);
    }


    #shopify-section-{{ section.id }} .pdp-product-info__grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }


    #shopify-section-{{ section.id }} .pdp-product-info__item--wide {
      grid-column: span 2;
    }


    #shopify-section-{{ section.id }} .pdp-detail-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }

  }


  /* =========================
     MOBILE
  ========================= */

  @media screen and (max-width: 749px) {

    #shopify-section-{{ section.id }} .pdp-story {
      padding:
        {{ section.settings.mobile_padding_top }}px
        {{ section.settings.mobile_horizontal_padding }}px
        {{ section.settings.mobile_padding_bottom }}px;
    }


    #shopify-section-{{ section.id }} .pdp-story__intro {
      margin-bottom: 32px;

      text-align: left;
    }


    #shopify-section-{{ section.id }} .pdp-items--features {
      grid-template-columns: 1fr;

      margin-bottom:
        {{ section.settings.mobile_feature_bottom_spacing }}px;
    }


    #shopify-section-{{ section.id }} .pdp-feature-item {
      padding: 20px 0;

      border-right: 0;

      border-bottom:
        1px solid rgba(0, 0, 0, 0.12);
    }


    #shopify-section-{{ section.id }} .pdp-feature-item:last-child {
      border-bottom: 0;
    }


    #shopify-section-{{ section.id }} .pdp-product-info {
      margin-bottom:
        {{ section.settings.mobile_details_bottom_spacing }}px;
    }


    #shopify-section-{{ section.id }} .pdp-product-info__grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }


    #shopify-section-{{ section.id }} .pdp-product-info__item--wide {
      grid-column: span 2;
    }


    #shopify-section-{{ section.id }} .pdp-detail-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: {{ section.settings.mobile_image_gap }}px;
    }


    #shopify-section-{{ section.id }} .pdp-detail-card figcaption {
      font-size: 9px;
    }

  }

{% endstyle %}


