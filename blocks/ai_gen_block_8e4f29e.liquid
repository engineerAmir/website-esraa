{% doc %}
  @prompt
    hero
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-{{ ai_gen_id }} {
    position: relative;
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    min-height: {{ block.settings.hero_height }}px;
    overflow: hidden;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-hero-{{ ai_gen_id }}__media,
  .ai-hero-{{ ai_gen_id }}__media img,
  .ai-hero-{{ ai_gen_id }}__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ai-hero-{{ ai_gen_id }}__media img {
    object-fit: cover;
    object-position: {{ block.settings.image_position }};
  }

  .ai-hero-{{ ai_gen_id }}__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ block.settings.background_color }};
  }

  .ai-hero-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
    opacity: 0.3;
  }

  .ai-hero-{{ ai_gen_id }}__empty-state {
    position: absolute;
    bottom: 24px;
    left: 50%;
    width: max-content;
    max-width: calc(100% - 32px);
    padding: 8px 12px;
    transform: translateX(-50%);
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    font-size: 13px;
    text-align: center;
  }

  .ai-hero-{{ ai_gen_id }}__overlay {
    position: absolute;
    inset: 0;
    background: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
  }

  .ai-hero-{{ ai_gen_id }}__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.content_alignment }};
    justify-content: {{ block.settings.content_position }};
    min-height: {{ block.settings.hero_height }}px;
    padding: 48px 6%;
    text-align: {{ block.settings.content_alignment }};
  }

  .ai-hero-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 12px;
    color: {{ block.settings.accent_color }};
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ai-hero-{{ ai_gen_id }}__heading {
    max-width: 760px;
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_heading_font.family }}, sans-serif;
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.08;
  }

  .ai-hero-{{ ai_gen_id }}__text {
    max-width: 600px;
    margin: 18px 0 0;
    color: {{ block.settings.text_color }};
    font-size: 18px;
    line-height: 1.5;
  }

  .ai-hero-{{ ai_gen_id }}__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .ai-hero-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 24px;
    border: 1px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_radius }}px;
    font-family: {{ settings.type_accent_font.family }}, sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .ai-hero-{{ ai_gen_id }}__button--primary {
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
  }

  .ai-hero-{{ ai_gen_id }}__button--secondary {
    background: {{ block.settings.secondary_button_background }};
    color: {{ block.settings.secondary_button_text }};
  }

  .ai-hero-{{ ai_gen_id }}__button:hover {
    opacity: 0.86;
  }

  .ai-hero-{{ ai_gen_id }}__button:focus-visible {
    outline: 3px solid {{ block.settings.accent_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_height }}px;
    }

    .ai-hero-{{ ai_gen_id }}__content {
      min-height: {{ block.settings.mobile_height }}px;
      padding: 36px 24px;
    }

    .ai-hero-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-hero-{{ ai_gen_id }}__text {
      font-size: 16px;
    }

    .ai-hero-{{ ai_gen_id }}__actions {
      width: 100%;
    }

    .ai-hero-{{ ai_gen_id }}__button {
      flex: 1 1 180px;
    }
  }
{% endstyle %}

<div class="ai-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-{{ ai_gen_id }}__media">
    {% if block.settings.image %}
      <img src="{{ block.settings.image | image_url: width: 2400 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
    {% else %}
      <div class="ai-hero-{{ ai_gen_id }}__placeholder">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-hero-{{ ai_gen_id }}__empty-state">Add a hero image to showcase your collection</div>
      </div>
    {% endif %}
  </div>
  <div class="ai-hero-{{ ai_gen_id }}__overlay"></div>
  <div class="ai-hero-{{ ai_gen_id }}__content">
    {% if block.settings.eyebrow != blank %}<p class="ai-hero-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
    {% if block.settings.heading != blank %}<h1 class="ai-hero-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h1>{% endif %}
    {% if block.settings.description != blank %}<p class="ai-hero-{{ ai_gen_id }}__text">{{ block.settings.description }}</p>{% endif %}
    <div class="ai-hero-{{ ai_gen_id }}__actions">
      {% if block.settings.primary_label != blank and block.settings.primary_link != blank %}<a class="ai-hero-{{ ai_gen_id }}__button ai-hero-{{ ai_gen_id }}__button--primary" href="{{ block.settings.primary_link }}">{{ block.settings.primary_label }}</a>{% endif %}
      {% if block.settings.secondary_label != blank and block.settings.secondary_link != blank %}<a class="ai-hero-{{ ai_gen_id }}__button ai-hero-{{ ai_gen_id }}__button--secondary" href="{{ block.settings.secondary_link }}">{{ block.settings.secondary_label }}</a>{% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Fashion hero",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Designed to be noticed" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Discover expressive pieces made for your everyday style." },
    { "type": "text", "id": "primary_label", "label": "Primary label", "default": "Shop collection" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary label", "default": "Explore styles" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "hero_height", "label": "Desktop height", "min": 360, "max": 900, "step": 20, "unit": "px", "default": 620 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 320, "max": 700, "step": 20, "unit": "px", "default": 520 },
    { "type": "select", "id": "content_alignment", "label": "Text alignment", "options": [{ "value": "flex-start", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "flex-end", "label": "Right" }], "default": "flex-start" },
    { "type": "select", "id": "content_position", "label": "Vertical position", "options": [{ "value": "flex-start", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "flex-end", "label": "Bottom" }], "default": "center" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [{ "value": "center center", "label": "Center" }, { "value": "left center", "label": "Left" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }], "default": "center center" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 32, "max": 96, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 28, "max": 60, "step": 4, "unit": "px", "default": 40 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f7f2ec" },
    { "type": "color", "id": "overlay_color", "label": "Overlay", "default": "#2a2526" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 25 },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#e9dadb" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#6d263d" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#f7f2ec" },
    { "type": "color", "id": "button_border_color", "label": "Button border", "default": "#6d263d" },
    { "type": "color", "id": "secondary_button_background", "label": "Secondary background", "default": "#f7f2ec" },
    { "type": "color", "id": "secondary_button_text", "label": "Secondary text", "default": "#6d263d" },
    { "type": "range", "id": "button_radius", "label": "Button radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 4 }
  ],
  "presets": [{ "name": "Fashion hero" }],
  "tag": null,
  "class": "fashion-hero-block"
}
{% endschema %}