{% doc %}
  @prompt
    all products section collection 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-all-products-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
  }

  .ai-all-products-{{ ai_gen_id }}__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }

  .ai-all-products-{{ ai_gen_id }}__title {
    margin: 0;
    font-family: {{ settings.type_heading_font.family }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.1;
  }

  .ai-all-products-{{ ai_gen_id }}__count {
    margin: 0;
    font-size: 13px;
    opacity: .75;
  }

  .ai-all-products-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-all-products-{{ ai_gen_id }}__card {
    min-width: 0;
  }

  .ai-all-products-{{ ai_gen_id }}__image-link {
    display: block;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: {{ block.settings.image_background }};
    border-radius: {{ settings.product_corner_radius }}px;
  }

  .ai-all-products-{{ ai_gen_id }}__image-link img,
  .ai-all-products-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-all-products-{{ ai_gen_id }}__placeholder {
    width: 100%;
    height: 100%;
  }

  .ai-all-products-{{ ai_gen_id }}__details {
    padding-top: 12px;
  }

  .ai-all-products-{{ ai_gen_id }}__product-title {
    display: block;
    color: inherit;
    font-size: 14px;
    line-height: 1.35;
    text-decoration: none;
  }

  .ai-all-products-{{ ai_gen_id }}__price {
    margin-top: 6px;
    font-size: 14px;
    font-weight: 600;
  }

  .ai-all-products-{{ ai_gen_id }}__empty {
    padding: 48px 20px;
    text-align: center;
    border: 1px solid {{ block.settings.text_color }};
    border-radius: {{ settings.card_corner_radius }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-all-products-{{ ai_gen_id }}__header {
      align-items: start;
      flex-direction: column;
      gap: 8px;
    }

    .ai-all-products-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: {{ block.settings.mobile_gap }}px;
    }
  }
{% endstyle %}

<div class="ai-all-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.collection != blank %}
    <div class="ai-all-products-{{ ai_gen_id }}__header">
      <h2 class="ai-all-products-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>
      <p class="ai-all-products-{{ ai_gen_id }}__count">{{ block.settings.collection.products_count }} products</p>
    </div>

    {% if block.settings.collection.products_count > 0 %}
      <div class="ai-all-products-{{ ai_gen_id }}__grid">
        {% for product in block.settings.collection.products limit: block.settings.products_to_show %}
          <article class="ai-all-products-{{ ai_gen_id }}__card">
            <a class="ai-all-products-{{ ai_gen_id }}__image-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="900" height="1200">
              {% else %}
                <div class="ai-all-products-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
              {% endif %}
            </a>
            <div class="ai-all-products-{{ ai_gen_id }}__details">
              <a class="ai-all-products-{{ ai_gen_id }}__product-title" href="{{ product.url }}">{{ product.title | escape }}</a>
              <div class="ai-all-products-{{ ai_gen_id }}__price">{{ product.price | money }}</div>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-all-products-{{ ai_gen_id }}__empty">This collection has no products yet.</div>
    {% endif %}
  {% else %}
    <div class="ai-all-products-{{ ai_gen_id }}__empty">Select a collection to display its products.</div>
  {% endif %}
</div>

{% schema %}
{
  "name": "All products collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All products"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 50,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 18,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 8,
      "max": 28,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#6d263d"
    },
    {
      "type": "color",
      "id": "image_background",
      "label": "Image background",
      "default": "#f7f2ec"
    }
  ],
  "presets": [
    {
      "name": "All products collection"
    }
  ],
  "tag": null,
  "class": "all-products-collection-block"
}
{% endschema %}