{% doc %}
  @prompt
    create section for brand story in footer resposive 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-brand-story-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-brand-story-{{ ai_gen_id }}__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    gap: 48px;
    align-items: center;
    padding: 48px 32px;
  }

  .ai-brand-story-{{ ai_gen_id }}__media {
    overflow: hidden;
    border-radius: {{ block.settings.image_radius }}px;
    aspect-ratio: 4 / 3;
    background: {{ block.settings.image_placeholder_color }};
  }

  .ai-brand-story-{{ ai_gen_id }}__media img,
  .ai-brand-story-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-brand-story-{{ ai_gen_id }}__media svg {
    color: {{ block.settings.text_color }};
    opacity: 0.45;
  }

  .ai-brand-story-{{ ai_gen_id }}__content {
    max-width: 620px;
  }

  .ai-brand-story-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 12px;
    color: {{ block.settings.accent_color }};
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ai-brand-story-{{ ai_gen_id }}__heading {
    margin: 0 0 16px;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.1;
  }

  .ai-brand-story-{{ ai_gen_id }}__copy {
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.7;
  }

  .ai-brand-story-{{ ai_gen_id }}__copy p {
    margin: 0 0 14px;
  }

  .ai-brand-story-{{ ai_gen_id }}__copy p:last-child {
    margin-bottom: 0;
  }

  .ai-brand-story-{{ ai_gen_id }}__link {
    display: inline-flex;
    margin-top: 24px;
    padding: 12px 22px;
    border: 1px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .ai-brand-story-{{ ai_gen_id }}__link:hover,
  .ai-brand-story-{{ ai_gen_id }}__link:focus-visible {
    opacity: 0.82;
  }

  .ai-brand-story-{{ ai_gen_id }}__link:focus-visible {
    outline: 2px solid {{ block.settings.accent_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-brand-story-{{ ai_gen_id }}__inner {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 32px 20px;
    }

    .ai-brand-story-{{ ai_gen_id }}__content {
      max-width: none;
    }

    .ai-brand-story-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.heading_size | times: 0.78 }}px;
    }

    @media screen and (max-width: 749px) {
  .ai-brand-story-{{ ai_gen_id }}__inner {
    grid-template-columns: 1fr;
    gap: 28px;
    padding: 32px 20px;
    text-align: center;
  }

  .ai-brand-story-{{ ai_gen_id }}__content {
    max-width: none;
    width: 100%;
    text-align: center;
    margin: 0 auto;
  }

  .ai-brand-story-{{ ai_gen_id }}__eyebrow,
  .ai-brand-story-{{ ai_gen_id }}__heading,
  .ai-brand-story-{{ ai_gen_id }}__copy {
    text-align: center;
  }

  .ai-brand-story-{{ ai_gen_id }}__heading {
    font-size: {{ block.settings.heading_size | times: 0.78 }}px;
  }

  .ai-brand-story-{{ ai_gen_id }}__link {
    margin-left: auto;
    margin-right: auto;
    justify-content: center;
  }
}
  }
{% endstyle %}

<div class="ai-brand-story-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-brand-story-{{ ai_gen_id }}__inner">
    <div class="ai-brand-story-{{ ai_gen_id }}__media">
      {% if block.settings.image != blank %}
        <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
      {% else %}
        {{ 'image' | placeholder_svg_tag }}
      {% endif %}
    </div>

    <div class="ai-brand-story-{{ ai_gen_id }}__content">
      {% if block.settings.eyebrow != blank %}
        <p class="ai-brand-story-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if block.settings.heading != blank %}
        <h2 class="ai-brand-story-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
      {% endif %}
      {% if block.settings.story != blank %}
        <div class="ai-brand-story-{{ ai_gen_id }}__copy">{{ block.settings.story }}</div>
      {% endif %}
      {% if block.settings.button_label != blank and block.settings.button_link != blank %}
        <a class="ai-brand-story-{{ ai_gen_id }}__link" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brand story",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed with intention"
    },
    {
      "type": "richtext",
      "id": "story",
      "label": "Story",
      "default": "<p>We create considered pieces that celebrate confidence, craftsmanship, and effortless style.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7f2ec"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#6d263d"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#2a2526"
    },
    {
      "type": "color",
      "id": "image_placeholder_color",
      "label": "Image placeholder",
      "default": "#e9dadb"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button",
      "default": "#6d263d"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#f7f2ec"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "shippori_antique_n4"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "comfortaa_n4"
    }
  ],
  "presets": [
    {
      "name": "Brand story"
    }
  ],
  "tag": null,
  "class": "brand-story-block"
}
{% endschema %}