

{% liquid
  assign block_settings = block.settings
  assign use_inverse_logo = false

  if section.settings.enable_transparent_header_home and template.name == 'index' and section.settings.home_inverse_logo == true
    assign use_inverse_logo = true
  elsif section.settings.enable_transparent_header_product and template.name == 'product' and section.settings.product_inverse_logo == true
    assign use_inverse_logo = true
  elsif section.settings.enable_transparent_header_collection and template.name == 'collection' and section.settings.collection_inverse_logo == true
    assign use_inverse_logo = true
  endif

  if use_inverse_logo
    if settings.logo_inverse != blank
      assign inverse_logo = settings.logo_inverse
    else
      assign inverse_logo = settings.logo
    endif
  endif

  assign desktop_logo = section.settings.desktop_logo | default: settings.logo
  assign mobile_logo = section.settings.mobile_logo | default: desktop_logo
  assign transparent_logo = section.settings.transparent_logo | default: inverse_logo | default: desktop_logo
  if section.settings.transparent_logo != blank
    assign use_inverse_logo = true
  endif

  assign alt_text_fallback = 'accessibility.home_logo_alt' | t: store_name: shop.name
%}

{% comment %}
  Output all logo variants, use CSS to hide/show the appropriate one
  based on the .header[transparent] selector
{% endcomment %}
<a
  {% if template.name == 'index' and block_settings.hide_logo_on_home_page %}
    data-hidden-on-home-page
  {% endif %}
  href="{{ routes.root_url }}"
  class="size-style spacing-style header-logo"
  style="
    {% render 'size-style', settings: block_settings %}
    {% render 'spacing-style', settings: block_settings %}
    --font-family: var(--font-body--family);
    --font-style: var(--font-body--style);
    --font-weight: 600;
  "
  {{ block.shopify_attributes }}
>
  {% liquid
    assign logo_width = section.settings.desktop_logo_width | default: settings.logo_height | times: desktop_logo.aspect_ratio | ceil
    assign logo_width_mobile = section.settings.mobile_logo_width | default: settings.logo_height_mobile | times: mobile_logo.aspect_ratio | ceil
    assign inverse_logo_width = section.settings.desktop_logo_width | default: settings.logo_height | times: transparent_logo.aspect_ratio | ceil
    assign inverse_logo_width_mobile = section.settings.mobile_logo_width | default: settings.logo_height_mobile | times: transparent_logo.aspect_ratio | ceil
    assign logo_style = '--header-logo-image-width: ' | append: logo_width | append: 'px;' | append: '--header-logo-image-width-mobile: ' | append: logo_width_mobile | append: 'px; --header-logo-image-height: ' | append: settings.logo_height | append: 'px; --header-logo-image-height-mobile: ' | append: settings.logo_height_mobile | append: 'px;'
    assign inverse_logo_style = '--header-logo-image-width: ' | append: inverse_logo_width | append: 'px;' | append: '--header-logo-image-width-mobile: ' | append: inverse_logo_width_mobile | append: 'px; --header-logo-image-height: ' | append: settings.logo_height | append: 'px; --header-logo-image-height-mobile: ' | append: settings.logo_height_mobile | append: 'px;'
  %}

  <span
    {% if use_inverse_logo %}
      class="header-logo__solid-header-image-container"
    {% endif %}
    data-testid="header-logo"
  >
    {% render 'image',
      image: desktop_logo,
      class: 'header-logo__image',
      height: settings.logo_height,
      alt_text_fallback: alt_text_fallback,
      text_fallback: shop.name,
      style: logo_style
    %}
    {% render 'image',
      image: mobile_logo,
      class: 'header-logo__image header-logo__image--mobile',
      height: settings.logo_height_mobile,
      alt_text_fallback: alt_text_fallback,
      text_fallback: shop.name,
      style: logo_style
    %}
  </span>

  {% if use_inverse_logo %}
    <span
      class="header-logo__transparent-header-image-container"
      data-testid="header-logo-inverse"
    >
      {% render 'image',
        image: transparent_logo,
        class: 'header-logo__image',
        height: settings.logo_height,
        alt_text_fallback: alt_text_fallback,
        text_fallback: shop.name,
        style: inverse_logo_style
      %}
      {% render 'image',
        image: transparent_logo,
        class: 'header-logo__image header-logo__image--mobile',
        height: settings.logo_height_mobile,
        alt_text_fallback: alt_text_fallback,
        text_fallback: shop.name,
        style: inverse_logo_style
      %}
    </span>
  {% endif %}
</a>

{% stylesheet %}
  .header-logo {
    display: flex;
    height: 100%;
    font-size: var(--font-size--md);
    font-family: var(--font-family);
    font-weight: var(--font-weight);
    font-style: var(--font-style);
    color: var(--color-foreground);
    justify-content: center;
    align-items: center;
    text-decoration: none;

    &[data-hidden-on-home-page] {
      display: none;

      #header-component:is(
          [sticky='always']:not([data-scroll-direction='none']),
          [sticky='scroll-up'][data-scroll-direction='up']
        )
        & {
        display: flex;
      }
    }

    @media screen and (max-width: 749px) {
      padding: 0;
    }

    @media screen and (min-width: 750px) {
      flex-shrink: 0;
    }

    &:hover {
      text-decoration: none;
    }
  }

  .header-logo__image {
    object-fit: contain;
    height: var(--header-logo-image-height-mobile);
    width: var(--header-logo-image-width-mobile);

    @media screen and (min-width: 750px) {
      height: var(--header-logo-image-height);
      width: var(--header-logo-image-width);
    }
  }

  .header-logo__image--mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .header-logo__image:not(.header-logo__image--mobile) {
      display: none;
    }

    .header-logo__image--mobile {
      display: block;
    }
  }

  .header-logo__solid-header-image-container {
    display: var(--header-logo-display, block);
  }

  .header-logo__transparent-header-image-container {
    display: var(--header-logo-inverse-display, none);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.logo",
  "tag": null,
  "class": "header-logo",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.edit_logo_in_theme_settings"
    },
    {
      "type": "image_picker",
      "id": "desktop_logo",
      "label": "Desktop logo"
    },
    {
      "type": "image_picker",
      "id": "mobile_logo",
      "label": "Mobile logo"
    },
    {
      "type": "image_picker",
      "id": "transparent_logo",
      "label": "Transparent header logo"
    },
    {
      "type": "range",
      "id": "desktop_logo_width",
      "label": "Desktop logo width",
      "min": 40,
      "max": 360,
      "step": 4,
      "unit": "px",
      "default": 160
    },
    {
      "type": "range",
      "id": "mobile_logo_width",
      "label": "Mobile logo width",
      "min": 40,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "header",
      "content": "t:content.visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_logo_on_home_page",
      "label": "t:settings.hide_logo_on_home_page",
      "info": "t:info.hide_logo_on_home_page_help"
    },
    {
      "type": "header",
      "content": "t:content.padding_desktop"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
